<UserControl x:Class="LLMWorkGUI.App.Views.StateControls.LoadingStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LLMWorkGUI.App;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="StateRoot"
            Style="{DynamicResource PanelBorder}"
            Padding="20,16"
            Margin="8"
            AutomationProperties.Name="Состояние загрузки">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar x:Name="LoadingProgress"
                         IsIndeterminate="True"
                         Height="6"
                         Width="220"
                         HorizontalAlignment="Center"
                         AutomationProperties.Name="Идёт загрузка" />
            <TextBlock x:Name="MessageText"
                       Text="{Binding Message}"
                       Style="{DynamicResource SecondaryText}"
                       TextAlignment="Center"
                       Margin="0,10,0,0" />
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource CompactButton}"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Отменить текущую операцию" />
        </StackPanel>
    </Border>
</UserControl>
