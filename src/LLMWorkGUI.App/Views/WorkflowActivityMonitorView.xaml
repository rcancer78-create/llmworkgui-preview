<UserControl x:Class="LLMWorkGUI.App.Views.WorkflowActivityMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LLMWorkGUI.App.ViewModels"
             xmlns:converters="clr-namespace:LLMWorkGUI.App.Converters"
             Background="{DynamicResource Theme.Background}"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="ActivityNodeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Width" Value="210" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Compact consolidated navigation (ROADMAP Phase 11): schema, activity stream, inspector. -->
        <Style x:Key="MonitorModeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorSchemaButton" TargetType="Button" BasedOn="{StaticResource MonitorModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSchemaMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorActivityButton" TargetType="Button" BasedOn="{StaticResource MonitorModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActivityMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorInspectorButton" TargetType="Button" BasedOn="{StaticResource MonitorModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInspectorMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The drawer is a side panel next to the schema and becomes the whole surface in inspector mode. -->
        <Style x:Key="MonitorDrawerPanel" TargetType="Border">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="390" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInspectorMode}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
            <WrapPanel Margin="0,2,0,0">
                <TextBlock Text="Запуск:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding RunSummaryDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                <TextBlock Text="Активная версия:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding ActiveVersionDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                <TextBlock Text="Объявленные роли:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding DeclaredRolesDisplay}" Style="{DynamicResource StatusValue}" />
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,6,0,6">
            <TextBlock Text="{Binding SchemaNote}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RouteProvenanceNote}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConcurrencyNote}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,2,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding ActivePanelModeDisplay}"
                       Style="{DynamicResource StatusValue}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <Border Style="{DynamicResource SegmentedContainer}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MonitorSchemaModeButton"
                            Content="Схема графа"
                            Style="{StaticResource MonitorSchemaButton}"
                            Command="{Binding SelectPanelModeCommand}"
                            CommandParameter="{x:Static vm:WorkflowMonitorPanelMode.Schema}"
                            AutomationProperties.Name="Показать схему графа" />
                    <Button x:Name="MonitorActivityModeButton"
                            Content="Поток активности"
                            Style="{StaticResource MonitorActivityButton}"
                            Command="{Binding SelectPanelModeCommand}"
                            CommandParameter="{x:Static vm:WorkflowMonitorPanelMode.Activity}"
                            AutomationProperties.Name="Показать поток активности" />
                    <Button x:Name="MonitorInspectorModeButton"
                            Content="Инспектор"
                            Style="{StaticResource MonitorInspectorButton}"
                            Command="{Binding SelectPanelModeCommand}"
                            CommandParameter="{x:Static vm:WorkflowMonitorPanelMode.Inspector}"
                            AutomationProperties.Name="Показать инспектор" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The role schema always stays visible in schema mode; the drawer opens next to it. -->
            <Border Grid.Column="0"
                    Style="{DynamicResource PanelBorder}"
                    Visibility="{Binding IsSchemaMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Схема ролей (роли активной версии и наблюдаемые события запуска)"
                                       Style="{DynamicResource SectionHeaderText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{DynamicResource BadgeBorder}" Margin="0">
                                <TextBlock Text="СХЕМА ГРАФА" Style="{DynamicResource BadgeText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding EmptyStateMessage}"
                               Style="{DynamicResource WarningText}"
                               TextWrapping="Wrap"
                               Margin="8,6,8,0"
                               Visibility="{Binding HasRun, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="8">
                        <ItemsControl ItemsSource="{Binding Nodes}"
                                      Visibility="{Binding HasNodes, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <Border Style="{StaticResource ActivityNodeCard}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right"
                                                            Style="{DynamicResource WorkingPill}"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Current" Style="{DynamicResource WorkingPillText}" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Theme.Text.Disabled}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="{x:Static vm:WorkflowActivityNodeStatus.Running}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.Accent}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="{x:Static vm:WorkflowActivityNodeStatus.Stalled}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.Warning}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="{x:Static vm:WorkflowActivityNodeStatus.Stopped}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.Error}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="{x:Static vm:WorkflowActivityNodeStatus.Completed}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.Success}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,0,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Theme.Status.Idle.Background}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Idle.Border}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Running}">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Working.Background}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Working.Border}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Completed}">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Done.Background}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Done.Border}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Stalled}">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Hung.Background}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Hung.Border}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Stopped}">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Stopped.Background}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Stopped.Border}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               ToolTip="{Binding StatusDetail}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Idle.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Running}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Working.Text}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Completed}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Done.Text}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Stalled}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Hung.Text}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WorkflowActivityNodeStatus.Stopped}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Stopped.Text}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <Border Style="{DynamicResource BadgeBorder}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,4"
                                                        Visibility="{Binding IsParallelReadOnly, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding ParallelDisplay}"
                                                               Style="{DynamicResource WarningText}"
                                                               FontSize="10" />
                                                </Border>

                                                <TextBlock Text="{Binding RouteSummaryDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding ModelAccountDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding LastActivityDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontFamily="Consolas, Cascadia Code, monospace"
                                                           FontSize="9"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding TransitionArrowDisplay}"
                                                   Foreground="{DynamicResource Theme.Text.Secondary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,8,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{DynamicResource PanelSplitter}"
                          Visibility="{Binding IsSchemaDrawerSplitterVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Details drawer of the selected role node; in inspector mode it becomes the full surface. -->
            <Border Style="{StaticResource MonitorDrawerPanel}"
                    Visibility="{Binding IsDrawerPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Подробности" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                                <TextBlock Text="{Binding Drawer.RoleDisplay}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Drawer.StatusDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding InspectorEmptyMessage}"
                               Style="{DynamicResource WarningText}"
                               TextWrapping="Wrap"
                               Margin="8,8,8,0"
                               Visibility="{Binding IsInspectorEmptyVisible, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsDrawerContentVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Drawer.SourceRoleDisplay}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Drawer.ReceivedAtDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Drawer.UpdatedAtDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Drawer.ActiveTurnsDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Drawer.ModelAccountDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Drawer.ParallelProofNote}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Drawer.EvidenceSourceDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Текущая работа (полный текст)" Style="{DynamicResource SectionHeaderText}" />
                            <TextBox Text="{Binding Drawer.WorkText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80"
                                     MaxHeight="220" />
                            <TextBlock Text="{Binding Drawer.WorkTextNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       Visibility="{Binding Drawer.HasWorkText, Converter={StaticResource InverseBoolToVisibility}}" />

                            <TextBlock Text="Свидетельства маршрута" Style="{DynamicResource SectionHeaderText}" />
                            <ItemsControl ItemsSource="{Binding Drawer.RouteEvidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource TimelineCard}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RouteEvidenceDisplay}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ExecutionDisplay}"
                                                               Style="{DynamicResource SecondaryText}"
                                                               FontSize="10" />
                                                    <TextBlock Text="{Binding StateDisplay}"
                                                               Style="{DynamicResource SecondaryText}"
                                                               FontSize="10"
                                                               Margin="8,0,0,0" />
                                                    <Border Style="{DynamicResource SyntheticBadgeBorder}"
                                                            Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NativeSessionDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ModelAccountDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ReadOnlyTurnDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding EvidenceDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Активность" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="{Binding Drawer.ActivityWindowDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10" />
                            <ItemsControl ItemsSource="{Binding Drawer.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource TimelineCard}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OccurredAtDisplay}"
                                                               Style="{DynamicResource StatusLabel}" />
                                                    <TextBlock Text="{Binding KindDisplay}"
                                                               FontWeight="SemiBold"
                                                               FontSize="10"
                                                               Margin="6,0,0,0" />
                                                    <Border Style="{DynamicResource SyntheticBadgeBorder}"
                                                            Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RoleDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RouteDisplay}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Drawer.HistoryEmptyMessage}"
                                       Style="{DynamicResource SecondaryText}"
                                       Visibility="{Binding Drawer.HasActivity, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Activity stream mode: the observed history feed without the schema. -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{DynamicResource PanelBorder}"
                    Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Поток активности" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                            <TextBlock Text="{Binding HistoryWindowDisplay}"
                                       Style="{DynamicResource StatusValue}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding ActivityModeNote}"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="8,4,8,0" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding ActivityEmptyMessage}"
                               Style="{DynamicResource SecondaryText}"
                               Margin="8,6,8,0"
                               Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource TimelineCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OccurredAtDisplay}"
                                                           Style="{DynamicResource StatusLabel}" />
                                                <TextBlock Text="{Binding KindDisplay}"
                                                           FontWeight="SemiBold"
                                                           FontSize="10"
                                                           Margin="6,0,0,0" />
                                                <Border Style="{DynamicResource SyntheticBadgeBorder}"
                                                        Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RoleDisplay}"
                                                       Style="{DynamicResource SecondaryText}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RouteDisplay}"
                                                       Style="{DynamicResource SecondaryText}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
