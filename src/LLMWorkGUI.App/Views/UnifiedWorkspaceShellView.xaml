<UserControl x:Class="LLMWorkGUI.App.Views.UnifiedWorkspaceShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LLMWorkGUI.App.ViewModels"
             xmlns:views="clr-namespace:LLMWorkGUI.App.Views"
             xmlns:help="clr-namespace:LLMWorkGUI.App.Help"
             xmlns:onboarding="clr-namespace:LLMWorkGUI.App.Views.Onboarding"
             xmlns:converters="clr-namespace:LLMWorkGUI.App.Converters"
             Background="{DynamicResource Theme.Background}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LLMWorkGUI.App;component/Themes/Shared.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LLMWorkGUI.App;component/Views/ScreenTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCliCommand}" />
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Workspace}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Projects}" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.ProvidersAccounts}" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Models}" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Quotas}" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Sessions}" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Runs}" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Workflows}" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.HealthCenter}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.SettingsDiagnostics}" />
    </UserControl.InputBindings>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource TopBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleLeftPaneButton" Command="{Binding ToggleLeftPaneCommand}"
                            Style="{DynamicResource ShellIconButton}" Content="&#xE700;" Margin="0,0,10,0"
                            ToolTip="Показать или скрыть навигацию" AutomationProperties.Name="Переключить левую панель навигации" />
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Theme.Accent}" Margin="0,0,10,0">
                        <Path Data="M 7,8 L 13,14 L 7,20 M 17,20 L 23,20" Stroke="{DynamicResource Theme.Accent.Text}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="LLMWorkGUI" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="OpenCommandPaletteButton" Grid.Column="1" Command="{Binding OpenCommandPaletteCommand}"
                        HorizontalContentAlignment="Stretch" MaxWidth="360" Margin="24,0" Padding="12,5"
                        Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border.Subtle}"
                        ToolTip="Найти команду или перейти в раздел (Ctrl+K)" AutomationProperties.Name="Открыть палитру команд">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Найти команду…" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Style="{DynamicResource Keycap}" Margin="12,0,0,0">
                            <TextBlock Text="Ctrl+K" Foreground="{DynamicResource Theme.Text.Secondary}" FontSize="10" />
                        </Border>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenHelpGuideButton" Command="{x:Static help:HelpCommands.OpenGuide}" Content="Руководство" ToolTip="Руководство пользователя и администратора (F1)" AutomationProperties.Name="Открыть руководство пользователя и администратора" Margin="4,0" />
                    <Button x:Name="OpenWorkflowConsoleButton" Command="{Binding OpenWorkflowConsoleCommand}"
                            Style="{DynamicResource ShellIconButton}" Content="&#xE8AB;" ToolTip="Консоль процессов"
                            AutomationProperties.Name="Открыть единую консоль Workflow Studio и Activity Monitor" />
                    <Button x:Name="OpenActivityCenterButton" Command="{Binding OpenActivityCenterCommand}"
                            Style="{DynamicResource ShellIconButton}" Content="&#xE9D9;" ToolTip="Центр активности"
                            AutomationProperties.Name="Открыть Центр активности" />
                    <Button x:Name="OpenOnboardingButton" Command="{Binding OpenOnboardingCommand}"
                            Style="{DynamicResource ShellIconButton}" Content="&#xE897;" ToolTip="Начало работы и справка"
                            AutomationProperties.Name="Открыть онбординг первого запуска" />
                    <Border Style="{DynamicResource VerticalDivider}" />
                    <Border Style="{DynamicResource SegmentedContainer}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DarkThemeButton" Command="{Binding ThemeSelector.SetDarkCommand}" Style="{DynamicResource DarkThemeButton}" AutomationProperties.Name="Переключить на тёмную тему" Content="Тёмная" />
                            <Button x:Name="LightThemeButton" Command="{Binding ThemeSelector.SetLightCommand}" Style="{DynamicResource LightThemeButton}" AutomationProperties.Name="Переключить на светлую тему" Content="Светлая" />
                            <Button x:Name="SystemThemeButton" Command="{Binding ThemeSelector.SetSystemCommand}" Style="{DynamicResource SystemThemeButton}" AutomationProperties.Name="Следовать системной теме" Content="Системная" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ToggleRightPaneButton" Command="{Binding ToggleRightPaneCommand}" Margin="8,0,0,0"
                            Style="{DynamicResource ShellIconButton}" Content="&#xE8A0;" ToolTip="Показать или скрыть инспектор"
                            AutomationProperties.Name="Переключить правую панель инспектора" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ShellPanes" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="{Binding LeftPaneGridLength}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="{Binding RightPaneGridLength}" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftPane"
                    Grid.Column="0"
                    Style="{DynamicResource PanelBorder}"
                    Margin="8,12,0,12"
                    Background="{DynamicResource Theme.Nav.Background}" BorderThickness="0"
                    Visibility="{Binding IsLeftPaneVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Навигация" TextWrapping="Wrap"
                                       Style="{DynamicResource SectionHeaderText}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleLeftPaneCommand}"
                                    Style="{DynamicResource CompactButton}"
                                    Padding="6,0"
                                    AutomationProperties.Name="Свернуть левую панель навигации"
                                    Content="◀" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Margin="10,8,10,2" Padding="0,12,0,0"
                            BorderBrush="{DynamicResource Theme.Border.Subtle}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="Обзор системы" Style="{DynamicResource SectionHeaderText}" Margin="8,0,0,6" />
                            <Button x:Name="QuotasHeaderWidget" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.Quotas}"
                                    Style="{DynamicResource QuietButton}" HorizontalContentAlignment="Left" ToolTip="Открыть квоты"
                                    AutomationProperties.Name="Квоты: открыть полный раздел Quotas">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Квоты" Style="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding QuotaSummary}" Style="{DynamicResource StatusValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HealthHeaderWidget" Command="{Binding NavigateScreenCommand}" CommandParameter="{x:Static vm:ScreenId.HealthCenter}"
                                    Style="{DynamicResource QuietButton}" HorizontalContentAlignment="Left" ToolTip="Открыть центр здоровья"
                                    AutomationProperties.Name="Здоровье: открыть полный раздел Health Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Здоровье" Style="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding BreakerHealthIndicator}" Style="{DynamicResource StatusValue}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ListBox
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{DynamicResource NavigationList}"
                             ItemContainerStyle="{DynamicResource NavigationItem}"
                             KeyboardNavigation.TabNavigation="Once"
                             Margin="4,8,4,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="9" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftSplitter"
                          Grid.Column="1"
                          Style="{DynamicResource PanelSplitter}"
                          Visibility="{Binding IsLeftPaneVisible, Converter={StaticResource BoolToVisibility}}"
                          DragCompleted="OnPaneSplitterDragCompleted" />

            <Border x:Name="CenterPane"
                    Grid.Column="2"
                    Style="{DynamicResource PanelBorder}"
                    Margin="0,12,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ActiveScreenTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveScreenDescription}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="OnScreenViewportSizeChanged" HorizontalContentAlignment="Stretch">
                        <ContentControl x:Name="MainScreenContent" Content="{Binding ActiveScreen}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="RightSplitter"
                          Grid.Column="3"
                          Style="{DynamicResource PanelSplitter}"
                          Visibility="{Binding IsInspectorDisplayed, Converter={StaticResource BoolToVisibility}}"
                          DragCompleted="OnPaneSplitterDragCompleted" />

            <Border x:Name="RightPane"
                    Grid.Column="4"
                    Style="{DynamicResource PanelBorder}"
                    Margin="0,12,12,12"
                    Visibility="{Binding IsInspectorDisplayed, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Инспектор / контекст"
                                       Style="{DynamicResource SectionHeaderText}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleRightPaneCommand}"
                                    Style="{DynamicResource CompactButton}"
                                    Padding="6,0"
                                    AutomationProperties.Name="Свернуть правую панель инспектора"
                                    Content="▶" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,8">
                        <StackPanel>
                            <TextBlock Text="Краткий статус" Style="{DynamicResource SectionHeaderText}" />
                            <Button x:Name="QuotasInspectorWidget"
                                    Style="{DynamicResource CompactButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,2"
                                    Command="{Binding NavigateScreenCommand}"
                                    CommandParameter="{x:Static vm:ScreenId.Quotas}"
                                    AutomationProperties.Name="Открыть полный раздел Quotas по клику на виджет">
                                <WrapPanel>
                                    <TextBlock Text="Квоты" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QuotaSummary}" Style="{DynamicResource StatusValue}" />
                                    <TextBlock Text=" / " Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding QuotaFreshness}" Style="{DynamicResource StatusValue}" />
                                </WrapPanel>
                            </Button>
                            <Button x:Name="HealthInspectorWidget"
                                    Style="{DynamicResource CompactButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,2"
                                    Command="{Binding NavigateScreenCommand}"
                                    CommandParameter="{x:Static vm:ScreenId.HealthCenter}"
                                    AutomationProperties.Name="Открыть Health Center по клику на виджет здоровья">
                                <WrapPanel>
                                    <TextBlock Text="Здоровье предохранителей" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BreakerHealthIndicator}" Style="{DynamicResource StatusValue}" />
                                </WrapPanel>
                            </Button>
                            <TextBlock Text="{Binding BreakerHealthDetail}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Обнаружение CLI" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CliDetectionIndicator}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>

                            <TextBlock Text="Центр активности" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="{Binding CommandPalette.Items.Count, StringFormat='{}{0} команд · Ctrl+K для открытия'}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10" />
                            <TextBlock Text="{Binding ShellNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       Visibility="{Binding HasShellNotice, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="Активный маршрут" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Провайдер" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Provider}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Аккаунт" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Account}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Модель" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Model}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Рассуждение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Reasoning}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Скорость" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Speed}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Решение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.RoutingDecisionReason}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>

                            <TextBlock Text="Сессия" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Локальный ID" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.LocalSessionId}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Нативный ID" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.NativeSessionId}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Подтверждение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.SessionConfirmation}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>

                            <TextBlock Text="Выполнение" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Состояние" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.ExecutionState}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Роль / этап" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.WorkflowRoleStage}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>

                            <TextBlock Text="Проект" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Рабочая область" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.ProjectWorkspace}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="ShellFooter" Grid.Row="2" Style="{DynamicResource StatusBarBorder}">
            <WrapPanel>
                <Button x:Name="QuotasFooterWidget"
                        Style="{DynamicResource CompactButton}"
                        Padding="4,1"
                        Command="{Binding NavigateScreenCommand}"
                        CommandParameter="{x:Static vm:ScreenId.Quotas}"
                        AutomationProperties.Name="Открыть Quotas по клику на виджет квот">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Квоты:" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding QuotaSummary}" Style="{DynamicResource StatusValue}" />
                        <TextBlock Text=" / " Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding QuotaFreshness}" Style="{DynamicResource StatusValue}" />
                    </StackPanel>
                </Button>
                <Border Style="{DynamicResource VerticalDivider}" />

                <Button x:Name="HealthFooterWidget"
                        Style="{DynamicResource CompactButton}"
                        Padding="4,1"
                        Command="{Binding NavigateScreenCommand}"
                        CommandParameter="{x:Static vm:ScreenId.HealthCenter}"
                        AutomationProperties.Name="Открыть Health Center по клику на виджет здоровья">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Здоровье предохранителей:" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding BreakerHealthIndicator}" Style="{DynamicResource StatusValue}" />
                    </StackPanel>
                </Button>
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Обнаружение CLI:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding CliDetectionIndicator}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Раскладка:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="Ctrl+K — палитра · F5 — обновление · Ctrl+1..Ctrl+0 — экраны"
                           Style="{DynamicResource StatusValue}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="{Binding IsActivityCenterOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Theme.Background}" Padding="8">
                <Button x:Name="CloseActivityCenterButton" Content="Закрыть центр активности"
                        HorizontalAlignment="Right" Command="{Binding CloseActivityCenterCommand}"
                        AutomationProperties.Name="Закрыть центр активности" />
            </Border>
            <views:ActivityCenterView x:Name="ActivityCenterOverlay"
                                      Grid.Row="1"
                                      DataContext="{Binding ActivityCenter}" />
        </Grid>

        <!-- Consolidated Workflow Console overlay (Studio + Monitor + quick import/export). -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              views:ModalFocus.CloseCommand="{Binding CloseWorkflowConsoleCommand}"
              Visibility="{Binding IsWorkflowConsoleOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <views:WorkflowConsoleView x:Name="WorkflowConsoleOverlay"
                                           DataContext="{Binding WorkflowConsole}" />
                <Button x:Name="CloseWorkflowConsoleButton"
                        Content="Закрыть консоль"
                        Style="{DynamicResource CompactButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,22,22,0"
                        Command="{Binding CloseWorkflowConsoleCommand}"
                        AutomationProperties.Name="Закрыть Workflow Console" />
            </Grid>
        </Grid>

        <!-- Onboarding overlay: re-openable and dismissible without blocking the interface. -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              views:ModalFocus.CloseCommand="{Binding CloseOnboardingCommand}"
              Visibility="{Binding IsOnboardingOpen, Converter={StaticResource BoolToVisibility}}">
            <onboarding:OnboardingView x:Name="OnboardingOverlay"
                                       DataContext="{Binding Onboarding}" />
        </Grid>

        <views:CommandPaletteView Grid.Row="0"
                                  Grid.RowSpan="3"
                                  DataContext="{Binding CommandPalette}" />
    </Grid>
</UserControl>
