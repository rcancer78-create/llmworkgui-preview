<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:LLMWorkGUI.App.ViewModels"
                    xmlns:views="clr-namespace:LLMWorkGUI.App.Views"
                    xmlns:converters="clr-namespace:LLMWorkGUI.App.Converters">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    <converters:DataClassificationDisplayConverter x:Key="DataClassificationDisplay" />

    <!-- Quota provenance/freshness badges: keep Exact/Plugin, Estimated/Local, Unknown/Unsupported
         and Error/Stale visually distinct (ТЗ §6.6). -->
    <Style x:Key="QuotaProvenanceBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Badge.Neutral.Background}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEstimatedLocal}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Warning.Surface}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsErrorOrStale}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Warning.Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuotaProvenanceBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Badge.Neutral.Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTrustedProvenance}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEstimatedLocal}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsErrorOrStale}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Error}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuotaFreshnessBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Badge.Neutral.Background}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsErrorOrStale}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Warning.Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuotaFreshnessBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Badge.Neutral.Text}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFresh}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsErrorOrStale}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Error}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type vm:CliToolStatusViewModel}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="0"
                       Text="{Binding DisplayName}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Style="{DynamicResource BadgeBorder}">
                <TextBlock Text="{Binding StatusDisplay}" Style="{DynamicResource BadgeText}" />
            </Border>
            <TextBlock Grid.Column="2"
                       Text="{Binding PathDisplay}"
                       ToolTip="{Binding Tooltip}"
                       Style="{DynamicResource SecondaryText}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActivityTimelineItemViewModel}">
        <Border Style="{DynamicResource TimelineCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SequenceDisplay}" Style="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding StageLabel}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoleDisplay}" Style="{DynamicResource SecondaryText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{DynamicResource BadgeBorder}">
                        <TextBlock Text="{Binding StateDisplay}" Style="{DynamicResource BadgeText}" />
                    </Border>
                    <Border Style="{DynamicResource SyntheticBadgeBorder}"
                            Visibility="{Binding IsSynthetic, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                    </Border>
                </StackPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="Маршрут:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding RouteDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                    <TextBlock Text="Сессия:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding SessionDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                    <TextBlock Text="Свидетельства:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding EvidenceDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                    <TextBlock Text="Посл. активность:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding LastActivityDisplay}" Style="{DynamicResource StatusValue}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="340" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
            <WrapPanel Margin="0,0,0,6">
                <Border Style="{DynamicResource BadgeBorder}">
                    <TextBlock Text="{Binding RunStateDisplay}" Style="{DynamicResource BadgeText}" />
                </Border>
                <Border Style="{DynamicResource BadgeBorder}" Margin="6,0,0,0">
                    <TextBlock Text="{Binding ProcessStateDisplay}" Style="{DynamicResource BadgeText}" />
                </Border>
                <Border Style="{DynamicResource BadgeBorder}" Margin="6,0,0,0">
                    <TextBlock Text="{Binding SessionStatusDisplay}" Style="{DynamicResource BadgeText}" />
                </Border>
                <TextBlock Text="{Binding NativeSessionId}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{DynamicResource SecondaryText}" />
                <Border Style="{DynamicResource SyntheticBadgeBorder}"
                        Visibility="{Binding HasSyntheticEvidence, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                </Border>
                <Button Content="Создать сессию" Command="{Binding CreateSessionCommand}" Margin="10,0,0,0" Style="{DynamicResource PrimaryButton}" />
                <Button Content="Сбросить" Command="{Binding ResetSessionCommand}" Margin="6,0,0,0" Style="{DynamicResource QuietButton}" />
                <Button Content="Новая сессия" Command="{Binding NewSessionCommand}" Margin="6,0,0,0" Style="{DynamicResource QuietButton}"
                        Visibility="{Binding IsProcessStarted, Converter={StaticResource BooleanToVisibility}}" />
                <Button Content="Отменить" Command="{Binding CancelTurnCommand}" Margin="6,0,0,0" Style="{DynamicResource QuietButton}" />
            </WrapPanel>

            <WrapPanel Margin="0,6,0,12">
                <TextBlock Text="Маршрут OpenCode" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding OpenCodeRoutes}" SelectedItem="{Binding SelectedOpenCodeRoute}" DisplayMemberPath="Display" IsEnabled="{Binding CanChooseOpenCodeRoute}" MinWidth="200" MaxWidth="320" AutomationProperties.Name="Маршрут OpenCode" />
                <Button Content="Обновить маршруты" Command="{Binding RefreshOpenCodeRoutesCommand}" Style="{DynamicResource CompactButton}" Margin="8,0,0,0" />
            </WrapPanel>
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <TextBlock Text="{Binding ConversationHeader}" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12">
                        <TextBlock Text="{Binding SendBlocker}" Foreground="{DynamicResource Theme.Warning}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasSendBlocker, Converter={StaticResource BooleanToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDiagnosticCliFallbackVisible, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,4">
                            <TextBlock Text="{Binding DiagnosticFallbackNote}" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                            <Button Content="Запустить диагностику CLI" Command="{Binding RunDiagnosticFallbackCommand}" Style="{DynamicResource CompactButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource Theme.Surface.Card}" CornerRadius="10" Padding="10"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBox x:Name="MessageComposer" Text="{Binding PromptInput, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" Height="54" Padding="4" Background="Transparent" BorderThickness="0"
                                             FontSize="13" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Сообщение модели" />
                                    <TextBlock Text="Опишите задачу или задайте вопрос…" Margin="5,5,12,0" IsHitTestVisible="False" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=MessageComposer}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Enter — новая строка" Style="{DynamicResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="Отправить ↑" Command="{Binding SendPromptCommand}" MinWidth="104" Padding="12,5" AutomationProperties.Name="Отправить сообщение" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="20,8" Visibility="{Binding HasConversation, Converter={StaticResource InverseBooleanToVisibility}}">
                            <Border Width="40" Height="40" Background="{DynamicResource Theme.Selection.Background}" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Theme.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Место для вашей следующей задачи" Foreground="{DynamicResource Theme.Text.Primary}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConversationEmptyState}" Style="{DynamicResource EmptyStateText}" Margin="12,8,12,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasConversation, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ConversationTurns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Theme.Border.Subtle}" BorderThickness="0,0,0,1" Padding="8,4">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Role}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" Style="{DynamicResource SecondaryText}" />
                                                </StackPanel>
                                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding PromptText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ResponseText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Theme.Text.Secondary}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                <Border Style="{DynamicResource PanelBorder}" Margin="0,0,0,8"
                        Visibility="{Binding HasPendingOpenCodePermissions, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Margin="12">
                        <TextBlock Text="OpenCode ожидает разрешение" Style="{DynamicResource SectionHeaderText}" />
                        <ComboBox ItemsSource="{Binding OpenCodePendingPermissions}" SelectedItem="{Binding SelectedOpenCodePermission}"
                                  DisplayMemberPath="Display" AutomationProperties.Name="Запрос разрешения OpenCode" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding SelectedOpenCodePermission.Kind}" Style="{DynamicResource SecondaryText}" />
                        <TextBlock Text="{Binding SelectedOpenCodePermission.Explanation}" Foreground="{DynamicResource Theme.Text.Primary}"
                                   TextWrapping="Wrap" Margin="0,4,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
                            <TextBlock Text="{Binding SelectedOpenCodePermission.OriginalRequestDisplay}" Foreground="{DynamicResource Theme.Text.Primary}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Исходный запрос OpenCode после очистки секретов" />
                        </ScrollViewer>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Разрешить один раз" Command="{Binding AllowOpenCodePermissionOnceCommand}"
                                    Style="{DynamicResource CompactButton}" AutomationProperties.Name="Разрешить запрос OpenCode один раз" />
                            <Button Content="Отклонить" Command="{Binding DenyOpenCodePermissionCommand}" Margin="8,0,0,0"
                                    Style="{DynamicResource CompactButton}" AutomationProperties.Name="Отклонить запрос OpenCode" />
                            <Button Content="На выполнение" IsEnabled="False" Margin="8,0,0,0" Style="{DynamicResource CompactButton}"
                                    ToolTip="Разрешение на одно выполнение недоступно: OpenCode предоставляет разовое разрешение или разрешение до конца сессии." />
                        </WrapPanel>
                        <TextBlock Text="{Binding OpenCodePermissionStatus}" Style="{DynamicResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Этапы процесса" Style="{DynamicResource SectionHeaderText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource StageChip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateDisplay}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="активен"
                                               Foreground="{DynamicResource Theme.Accent}"
                                               FontSize="11"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Этапы не зарегистрированы."
                           Style="{DynamicResource SecondaryText}"
                           FontSize="11"
                           Visibility="{Binding HasStages, Converter={StaticResource InverseBooleanToVisibility}}" />
                <TextBlock Text="{Binding RunReasonNote}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="3" Style="{DynamicResource PanelBorder}" Margin="0,6,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Хронология активности / ролей" Style="{DynamicResource SectionHeaderText}" Margin="0" VerticalAlignment="Center" />
                            <Border Style="{DynamicResource SyntheticBadgeBorder}"
                                    Visibility="{Binding HasSyntheticEvidence, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="SYNTHETIC" Style="{DynamicResource SyntheticBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding EvidenceNotice}"
                               Style="{DynamicResource WarningText}"
                               Margin="8,4,8,2"
                               Visibility="{Binding HasSyntheticEvidence, Converter={StaticResource BooleanToVisibility}}" />
                    <Grid>
                        <TextBlock Text="{Binding TimelineEmptyState}"
                                   Style="{DynamicResource EmptyStateText}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasTimeline, Converter={StaticResource InverseBooleanToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="8,6,8,6"
                                      Visibility="{Binding HasTimeline, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl ItemsSource="{Binding TimelineItems}" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{DynamicResource PanelBorder}" Margin="0,6,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <TextBlock Text="Различия" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                    </Border>
                    <StackPanel Margin="8,4,8,6">
                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding DiffSummary}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding DiffEmptyState}" Style="{DynamicResource SecondaryText}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The native Cursor ACP panel is rendered only when it is actually composed into this
                 window; nothing is faked in its place. -->
            <Border Grid.Row="5"
                    Style="{DynamicResource PanelBorder}"
                    Margin="0,6,0,0"
                    Visibility="{Binding HasCursorPanel, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Content="{Binding Cursor}" />
            </Border>

            <!-- The Mirasim panel is rendered only when the Mirasim backend is actually composed into
                 this window; nothing is faked in its place. -->
            <Border Grid.Row="6"
                    Style="{DynamicResource PanelBorder}"
                    Margin="0,6,0,0"
                    Visibility="{Binding HasMirasimPanel, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Content="{Binding Mirasim}" />
            </Border>
            <Border Grid.Row="7" Style="{DynamicResource PanelBorder}" Margin="0,6,0,0"
                    Visibility="{Binding HasNativeGatewayPanel, Converter={StaticResource BooleanToVisibility}}">
                <ContentControl Content="{Binding NativeGateway}" />
            </Border>
        </Grid></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NativeGatewayWorkspaceViewModel}">
        <StackPanel Margin="12">
            <TextBlock Text="LLMGateway" Style="{DynamicResource SectionHeaderText}" />
            <TextBlock Text="{Binding AccessNotice}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ProviderLimitations}" Style="{DynamicResource WarningText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ProjectDisplay}" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text.Primary}" AutomationProperties.Name="Проект LLMGateway" />
            <WrapPanel Margin="0,8,0,8">
                <Button Content="Обновить маршруты" Command="{Binding RefreshCommand}" Style="{DynamicResource QuietButton}"
                        AutomationProperties.Name="Обновить маршруты LLMGateway" />
                <Button Content="Отправить запрос" Command="{Binding SendCommand}" Margin="8,0,0,0" Style="{DynamicResource PrimaryButton}"
                        AutomationProperties.Name="Отправить запрос LLMGateway" />
                <Button Content="Отменить запрос" Command="{Binding CancelCommand}" Margin="8,0,0,0" Style="{DynamicResource QuietButton}"
                        AutomationProperties.Name="Отменить запрос LLMGateway" />
            </WrapPanel>
            <TextBlock Text="Доступный маршрут" Style="{DynamicResource SecondaryText}" />
            <ComboBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" DisplayMemberPath="Display"
                      IsEnabled="{Binding IsIdle}" Margin="0,4,0,8" AutomationProperties.Name="Маршрут LLMGateway" />
            <TextBlock Text="Новый запрос" Style="{DynamicResource SecondaryText}" />
            <Expander Header="Задание и ответ в файлах" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,4,0,8">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Файл задания UTF-8 (материалы для ревью включите в его текст)" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TaskFilePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Файл задания" />
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="Выбрать задание…" Command="{Binding ChooseTaskFileCommand}" />
                        <Button Content="Загрузить текст" Command="{Binding LoadTaskFileCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="Новый файл ответа (будет записан после успешного запроса)" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Файл ответа" />
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="Выбрать файл ответа…" Command="{Binding ChooseOutputFileCommand}" />
                        <Button Content="Сохранить ответ" Command="{Binding SaveResponseFileCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <TextBox Text="{Binding PromptInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="180"
                     MaxLength="1000000" Margin="0,4,0,8" AutomationProperties.Name="Текст запроса LLMGateway" />
            <TextBlock Text="{Binding Message}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.Name="Состояние запроса LLMGateway" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding Outcome}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.Name="Результат запроса LLMGateway" />
            <TextBlock Text="{Binding ExecutionDisplay}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Text="{Binding Response, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="300" AutomationProperties.Name="Ответ LLMGateway" />
        </StackPanel>
    </DataTemplate>

    <!-- Cursor ACP panel. Unknown fields render as 'Not reported', an unavailable backend is an
         explicit notice, and a permission request always waits for an explicit user decision
         (ADR-0003 §4.2, §7.2, ТЗ §6.9). -->
    <DataTemplate DataType="{x:Type vm:CursorWorkspaceEventViewModel}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Kind}" Style="{DynamicResource SecondaryText}" FontSize="10" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CursorWorkspaceViewModel}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Cursor ACP" Style="{DynamicResource SectionHeaderText}" />

            <!-- Degraded state: the backend is not configured for this window. -->
            <TextBlock Grid.Row="1"
                       Text="{Binding UnavailableNotice}"
                       Style="{DynamicResource WarningText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsBackendAvailable, Converter={StaticResource InverseBooleanToVisibility}}" />

            <WrapPanel Grid.Row="2"

                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Button Content="Запустить бэкенд" Command="{Binding StartBackendCommand}" Margin="0,0,4,0" />
                <Button Content="Остановить" Command="{Binding StopBackendCommand}" Margin="0,0,4,0" />
                <Button Content="Новая сессия" Command="{Binding CreateSessionCommand}" Margin="0,0,4,0" />
                <Button Content="Сбросить сессию" Command="{Binding ResetSessionCommand}" Margin="0,0,10,0" />
                <TextBlock Text="Бэкенд:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding BackendStateDisplay}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="Версия протокола:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ProtocolVersionDisplay}" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
            </WrapPanel>

            <WrapPanel Grid.Row="3"

                        Margin="0,4,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="Сессия:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding SessionStatusDisplay}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="Нативный ID:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding NativeSessionId}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="Шаг:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding TurnStateDisplay}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="Причина остановки:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding LastStopReason}" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
            </WrapPanel>

            <StackPanel Grid.Row="4" Margin="0,6,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="Запрошенный маршрут:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" DisplayMemberPath="Display"
                              Width="330" Margin="4,0" AutomationProperties.Name="Запрошенный маршрут Cursor" />
                    <Button Content="Обновить маршруты" Command="{Binding RefreshRoutesCommand}" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Режим:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox ItemsSource="{Binding AvailableModeIds}"
                              SelectedItem="{Binding SelectedModeId, Mode=TwoWay}"
                              Width="90"
                              Margin="4,0,10,0" />

                    <!-- An unverified mode always reports that the writer lock is required. -->
                    <TextBlock Text="Требуется блокировка записи"
                               Style="{DynamicResource WarningText}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Visibility="{Binding ModeRequiresWriterLock, Converter={StaticResource BooleanToVisibility}}" />
                </WrapPanel>

                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox Text="{Binding PromptInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="100" HorizontalAlignment="Stretch"
                             Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1">
                        <Button Content="Отправить запрос" Command="{Binding SendPromptCommand}" Margin="0,0,4,0" />
                        <Button Content="Отменить шаг" Command="{Binding CancelTurnCommand}" />
                    </WrapPanel>
                </Grid>

                <TextBlock Text="{Binding Blocker}"
                           Style="{DynamicResource WarningText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding Guidance}"
                           Style="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />

                <!-- Approval request: the decision always belongs to the user. -->
                <Border Style="{DynamicResource TimelineCard}"
                        Margin="0,6,0,0"
                        Visibility="{Binding IsAwaitingPermission, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Требуется разрешение" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding PendingPermissionKindDisplay}"
                                       Style="{DynamicResource WarningText}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding PendingPermissionDescription}" TextWrapping="Wrap" FontSize="11" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Разрешить один раз" Command="{Binding AllowOnceCommand}" Margin="0,0,4,0" />
                            <Button Content="Отклонить" Command="{Binding DenyPermissionCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="5"
                    Style="{DynamicResource TimelineCard}"
                    Margin="0,6,0,0"
                    Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Потоковые события" Style="{DynamicResource SectionHeaderText}" />
                    <ItemsControl ItemsSource="{Binding StreamEvents}" />
                    <TextBlock Text="События пока не наблюдались."
                               Style="{DynamicResource SecondaryText}"
                               FontSize="11"
                               Visibility="{Binding HasStreamEvents, Converter={StaticResource InverseBooleanToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Mirasim panel. Only observed evidence is rendered; unknown fields stay 'Not reported'. The
         route policy is fixed to ManualOnly, approvals are fail-closed, and the raw-recording
         disclaimer of the user-owned host is permanent (ADR-0008 §3, §8, §9, §10, ТЗ §6.5, §6.10). -->
    <DataTemplate DataType="{x:Type vm:MirasimWorkspaceViewModel}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Mirasim" Style="{DynamicResource SectionHeaderText}" />

            <!-- Degraded state: the backend is not configured for this window. -->
            <TextBlock Grid.Row="1"
                       Text="{Binding UnavailableNoticeText}"
                       Style="{DynamicResource WarningText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsBackendAvailable, Converter={StaticResource InverseBooleanToVisibility}}" />

            <WrapPanel Grid.Row="2"

                        Margin="0,4,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Button Content="Опросить хост" Command="{Binding ProbeHostCommand}" Margin="0,0,10,0" />
                <TextBlock Text="Хост:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding HostStateDisplay}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="url:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding HostUrl}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="версия:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding HostVersion}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="экземпляр:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding InstanceId}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="время работы:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding HostUptime}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="pid:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding HostPid}" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
            </WrapPanel>

            <WrapPanel Grid.Row="3"

                        Margin="0,6,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="Окружение:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <ComboBox ItemsSource="{Binding AvailableHarnesses}"
                          SelectedItem="{Binding SelectedHarness, Mode=TwoWay}"
                          Width="120"
                          Margin="4,0,10,0" />
                <TextBlock Text="Модель:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBox Text="{Binding ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="160"
                         Margin="4,0,10,0" />
                <TextBlock Text="Режим маршрутизации:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RouteMode}" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
            </WrapPanel>

            <WrapPanel Grid.Row="4"

                        Margin="0,6,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Button Content="Создать сессию" Command="{Binding CreateSessionCommand}" Margin="0,0,10,0" />
                <TextBlock Text="Сессия:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding SessionStatus}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="Ключ:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding SessionKey}" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" />
            </WrapPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,6,0,0"
                        Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox Text="{Binding PromptInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="100" HorizontalAlignment="Stretch"
                             Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1">
                        <Button Content="Отправить запрос" Command="{Binding SendPromptCommand}" Margin="0,0,4,0" />
                        <Button Content="Отменить шаг" Command="{Binding CancelTurnCommand}" Margin="0,0,4,0" />
                        <Button Content="Согласовать" Command="{Binding ReconcileTurnCommand}" />
                    </WrapPanel>
                </Grid>

                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="Шаг:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding TurnId}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                    <TextBlock Text="Статус:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Status}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                    <TextBlock Text="Класс ошибки:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ErrorClass}" VerticalAlignment="Center" FontSize="11" Margin="4,0,10,0" />
                    <TextBlock Text="Блокировка записи удержана"
                               Style="{DynamicResource WarningText}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Visibility="{Binding IsWriterLockHeld, Converter={StaticResource BooleanToVisibility}}" />
                </WrapPanel>

                <TextBlock Text="{Binding Blocker}"
                           Style="{DynamicResource WarningText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding Guidance}"
                           Style="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>

            <Border Grid.Row="6"
                    Style="{DynamicResource TimelineCard}"
                    Margin="0,6,0,0"
                    Visibility="{Binding IsBackendAvailable, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Наблюдаемые свидетельства шага" Style="{DynamicResource SectionHeaderText}" />
                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding AssistantResponse}" TextWrapping="Wrap" FontSize="11" />
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="модель:" Style="{DynamicResource StatusLabel}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ObservedModel}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                        <TextBlock Text="аккаунт:" Style="{DynamicResource StatusLabel}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ObservedAccount}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                        <TextBlock Text="плечо:" Style="{DynamicResource StatusLabel}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding ObservedLeg}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="7" Margin="0,6,0,0">
                <TextBlock Text="{Binding RecordingNoticeText}"
                           Style="{DynamicResource WarningText}"
                           TextWrapping="Wrap"
                           FontSize="11" />
                <TextBlock Text="{Binding ApprovalsNoticeText}"
                           Style="{DynamicResource WarningText}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding RoutePolicyNoticeText}"
                           Style="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ModelsRoutesViewModel}">
        <Grid Margin="10" Background="{DynamicResource Theme.Background}" TextElement.Foreground="{DynamicResource Theme.Text.Primary}">
            <Grid.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="0,0,0,6"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="16,9" Margin="0,0,5,0" CornerRadius="5" Background="{DynamicResource Theme.Surface.Alt}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Theme.Selection.Background}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Style="{DynamicResource CompactButton}" AutomationProperties.Name="Обновить модели и маршруты"/>
                <StackPanel><TextBlock Text="Модели и маршруты" Style="{DynamicResource ScreenHeaderText}"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}"/></StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Профиль провайдера" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModelProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseProfile}" AutomationProperties.Name="Профиль моделей"/>
                <TextBlock Text="{Binding ProfileNote}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,6,0,8"/>
                <TextBox x:Name="CatalogSearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Поиск сохранённых моделей и маршрутов" AutomationProperties.Name="Поиск в каталоге"/>
            </StackPanel>
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Настройка моделей и маршрутов">
                <TabItem Header="Модели">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Новая модель" Command="{Binding NewModelCommand}" Style="{DynamicResource CompactButton}"/><TextBlock Text="Сохранённые модели" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                            <ListBox x:Name="ConfiguredModelList" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Display" MinHeight="70" MaxHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Сохранённые модели"/>
                            <TextBlock Text="ID модели у провайдера" Margin="0,12,0,4"/>
                            <TextBox x:Name="NativeModelIdInput" Text="{Binding NativeModelId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditModelIdentity}" MaxLength="200" Padding="8,6" AutomationProperties.Name="ID модели у провайдера"/>
                            <TextBlock Text="Название" Margin="0,8,0,4"/>
                            <TextBox x:Name="ModelNameInput" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Padding="8,6" AutomationProperties.Name="Название модели"/>
                            <TextBlock Text="Поддержка модели" Margin="0,8,0,4"/>
                            <ComboBox x:Name="ModelCapabilityPicker" ItemsSource="{Binding CapabilityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Capability}" AutomationProperties.Name="Поддержка модели"/>
                            <CheckBox Content="Использовать модель" IsChecked="{Binding ModelEnabled}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding ModelOrigin}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}"/>
                            <Button Content="Сохранить модель" Command="{Binding SaveModelCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" Style="{DynamicResource CompactButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Маршруты">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Новый маршрут" Command="{Binding NewRouteCommand}" Style="{DynamicResource CompactButton}"/><TextBlock Text="Сохранённые маршруты" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                            <ListBox x:Name="ConfiguredRouteList" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" DisplayMemberPath="Display" MinHeight="70" MaxHeight="130" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Сохранённые маршруты"/>
                            <TextBlock Text="Аккаунт" Margin="0,12,0,4"/>
                            <ComboBox x:Name="RouteAccountPicker" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Name" IsEnabled="{Binding CanEditRouteBinding}" AutomationProperties.Name="Аккаунт маршрута"/>
                            <TextBlock Text="{Binding AccountNote}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            <TextBlock Text="Модель" Margin="0,8,0,4"/>
                            <ComboBox x:Name="RouteModelPicker" ItemsSource="{Binding RouteModels}" SelectedItem="{Binding RouteModel}" DisplayMemberPath="Display" IsEnabled="{Binding CanEditRouteBinding}" AutomationProperties.Name="Модель маршрута"/>
                            <TextBlock Text="Режим" Margin="0,8,0,4"/>
                            <ComboBox x:Name="RouteModePicker" ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RouteMode}" IsEnabled="{Binding CanEditRouteBinding}" AutomationProperties.Name="Режим маршрута"/>
                            <TextBlock Text="Допустимые данные" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding ClassificationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MaxDataClass}" AutomationProperties.Name="Классификация маршрута"/>
                            <TextBlock Text="Приоритет (меньшее число — выше)" Margin="0,8,0,4"/>
                            <TextBox x:Name="RoutePriorityInput" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Padding="8,6" AutomationProperties.Name="Приоритет маршрута"/>
                            <CheckBox Content="Использовать маршрут" IsChecked="{Binding RouteEnabled}" Margin="0,10,0,4"/>
                            <TextBlock Text="Привязка сохранённого маршрута не меняется. Для другого аккаунта, модели или режима создайте новый маршрут." TextWrapping="Wrap" Style="{DynamicResource SecondaryText}"/>
                            <Button Content="Сохранить маршрут" Command="{Binding SaveRouteCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" Style="{DynamicResource CompactButton}"/>
                            <Border Margin="0,12,0,4" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}"
                                    Visibility="{Binding NativeRouteSetup.IsVisible, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Подключить Cursor" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Подключение доступно только для Cursor. Проверяется вход официального CLI и наличие выбранной модели. Программа не переключает аккаунт Cursor." TextWrapping="Wrap" Margin="0,6,0,8"/>
                                    <TextBlock Text="Email нужного аккаунта Cursor"/>
                                    <TextBox x:Name="NativeCursorExpectedEmail" Text="{Binding NativeRouteSetup.ExpectedEmail, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding NativeRouteSetup.CanEdit}" MaxLength="254" Padding="8,6" AutomationProperties.Name="Email нужного аккаунта Cursor"/>
                                    <Button x:Name="NativeCursorPreviewButton" Content="Проверить вход Cursor" Command="{Binding NativeRouteSetup.PreviewCommand}"
                                            HorizontalAlignment="Left" Margin="0,8,0,8" Style="{DynamicResource CompactButton}"/>
                                    <TextBlock Text="{Binding NativeRouteSetup.ObservedIdentity}" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="NativeCursorModelConsent" IsChecked="{Binding NativeRouteSetup.ConfirmModelSupport}" IsEnabled="{Binding NativeRouteSetup.CanEdit}" Margin="0,10,0,4">
                                        <TextBlock Text="Подтверждаю поддержку текстовых запросов выбранной моделью на 24 часа (моя декларация, не результат проверки модели). Tools, Vision и варианты Reasoning не предоставляются." TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="NativeCursorUnverifiedConsent" IsChecked="{Binding NativeRouteSetup.AllowUnverifiedFirstRequest}" IsEnabled="{Binding NativeRouteSetup.CanEdit}" Margin="0,4,0,8">
                                        <TextBlock Text="Разрешаю первый запрос без подтверждённой модельной проверки: ForcedEnabled, восстановление не подтверждено." TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Text="Допустимые данные для подключения"/>
                                    <ComboBox x:Name="NativeCursorDataClass" ItemsSource="{Binding ClassificationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding NativeRouteSetup.MaxDataClass}" IsEnabled="{Binding NativeRouteSetup.CanEdit}" AutomationProperties.Name="Допустимые данные для подключения Cursor"/>
                                    <TextBlock Text="Настройка допустимых данных изменит политику общего профиля Cursor и выбранного маршрута. Это влияет на другие маршруты этого профиля. Разрешение передачи данных проектом не создаётся автоматически." TextWrapping="Wrap" Margin="0,6,0,8"/>
                                    <Button x:Name="NativeCursorActivateButton" Content="Включить выбранный маршрут" Command="{Binding NativeRouteSetup.ActivateCommand}"
                                            HorizontalAlignment="Left" Style="{DynamicResource CompactButton}"/>
                                    <TextBlock Text="{Binding NativeRouteSetup.StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Возможности">
                    <ContentControl Content="{Binding CapabilitiesEditor}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Warning}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ModelCapabilitiesEditorViewModel}">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Модель" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CapabilitiesModelPicker" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Модель для настройки возможностей"/>
                    <TextBlock Text="Аккаунт" Margin="0,8,0,4"/>
                    <ComboBox x:Name="CapabilitiesAccountPicker" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Аккаунт для настройки возможностей"/>
                    <TextBlock Text="{Binding ScopeNote}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,8,0,6"/>
                    <TextBlock Text="{Binding SavedEvidence}" TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>
                    <Button x:Name="DiscoverModelCapabilitiesButton" Content="Получить из нативного клиента" Command="{Binding DiscoverCommand}" IsEnabled="{Binding CanDiscover}" Margin="0,0,0,10" AutomationProperties.Name="Получить возможности выбранной модели и аккаунта из нативного клиента"/>
                    <StackPanel IsEnabled="{Binding CanSave}">
                        <CheckBox x:Name="CapabilitiesConfirmed" Content="Я подтверждаю поддержку указанных вручную возможностей" IsChecked="{Binding Confirmed}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CheckBox x:Name="CapabilityChat" Content="Чат" IsChecked="{Binding Chat}" Margin="0,0,16,6"/>
                            <CheckBox x:Name="CapabilityVision" Content="Изображения" IsChecked="{Binding Vision}" Margin="0,0,16,6"/>
                            <CheckBox x:Name="CapabilityTools" Content="Инструменты" IsChecked="{Binding Tools}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="Reasoning — точные значения через запятую" Margin="0,6,0,4"/>
                        <TextBox x:Name="CapabilityReasoningInput" Text="{Binding Reasoning, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="8256" AutomationProperties.Name="Поддерживаемые значения reasoning"/>
                        <TextBlock Text="Speed — точные значения через запятую" Margin="0,8,0,4"/>
                        <TextBox x:Name="CapabilitySpeedInput" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="8256" AutomationProperties.Name="Поддерживаемые значения speed"/>
                        <TextBlock Text="Режимы — точные значения через запятую" Margin="0,8,0,4"/>
                        <TextBox x:Name="CapabilityModesInput" Text="{Binding Modes, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="8256" AutomationProperties.Name="Поддерживаемые режимы модели"/>
                        <TextBlock Text="Лимит контекста (пусто, если неизвестен)" Margin="0,8,0,4"/>
                        <TextBox x:Name="CapabilityContextInput" Text="{Binding ContextLimit, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="10" AutomationProperties.Name="Подтверждённый лимит контекста"/>
                        <TextBlock Text="Срок после сохранения, часов (1–8760)" Margin="0,8,0,4"/>
                        <TextBox x:Name="CapabilityValidityInput" Text="{Binding ValidityHours, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="4" AutomationProperties.Name="Срок действия возможностей в часах"/>
                        <TextBlock Text="Незаполненные списки не разрешают дополнительные параметры. Снятие подтверждения блокирует применение сохранённых возможностей." TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,8,0,4"/>
                    </StackPanel>
                    <Button Content="Сохранить возможности" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,10,0,8" Style="{DynamicResource CompactButton}"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Warning}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CatalogScreenViewModel}">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}"/><TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}"/></StackPanel>
            <Grid Grid.Row="1" Margin="0,20,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="CatalogSearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" VerticalContentAlignment="Center" ToolTip="Поиск по названию, пути или состоянию" AutomationProperties.Name="Поиск в каталоге"/>
                    <TextBlock Text="Поиск по названию, пути или состоянию" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=CatalogSearchInput}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            </Grid>
            <Border Grid.Row="2" Style="{DynamicResource PanelBorder}" Padding="12" Margin="0,0,0,12" Visibility="{Binding IsProjects, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <Expander Header="Класс данных проекта" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,0,0,12">
                        <StackPanel DataContext="{Binding ProjectDataPolicy}" Margin="0,8,0,0">
                            <ComboBox x:Name="ProjectPolicyProjectPicker" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Проект для изменения класса данных"/>
                            <TextBlock Text="{Binding CurrentPolicy}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <TextBlock Text="Новый класс данных"/>
                            <ComboBox x:Name="ProjectPolicyClassPicker" ItemsSource="{Binding Choices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RequestedClass}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Новый класс данных проекта"/>
                            <CheckBox x:Name="ProjectPolicyConsent" IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanEdit}" Margin="0,8,0,8">
                                <TextBlock Text="Разрешаю применять выбранный класс к этому проекту. Это влияет на внешнюю передачу." TextWrapping="Wrap"/>
                            </CheckBox>
                            <WrapPanel><Button Content="Сохранить класс данных" Command="{Binding SaveCommand}" Margin="0,0,8,4" Style="{DynamicResource CompactButton}"/><Button Content="Обновить политику" Command="{Binding RefreshCommand}" Margin="0,0,0,4" Style="{DynamicResource CompactButton}"/></WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="Добавить проект" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="ProjectPathInput" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Полный путь к папке проекта" AutomationProperties.Name="Папка проекта"/>
                            <TextBlock Text="Полный путь к папке проекта" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=ProjectPathInput}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Content="Добавить" Style="{DynamicResource PrimaryButton}" Command="{Binding AddProjectCommand}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource Theme.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid Grid.Row="4">
                <Border Style="{DynamicResource PanelBorder}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel VerticalAlignment="Center" Margin="24">
                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding EmptyStateMessage}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding AvailabilityNote}" Style="{DynamicResource EmptyStateText}"/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibility}}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Style="{DynamicResource PanelBorder}" Padding="16" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Theme.Accent}" Margin="0,6,0,8"/>
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding Detail}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Id}" Style="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <TextBlock Grid.Row="5" Text="{Binding CountDisplay}" Style="{DynamicResource SecondaryText}" Margin="0,12,0,0"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GatewayCatalogImportViewModel}">
        <StackPanel Margin="0,6,0,2">
            <WrapPanel>
                <Button Content="Импортировать каталог LLMGateway" Command="{Binding ImportCommand}"
                        Style="{DynamicResource CompactButton}" Margin="0,0,8,4"
                        AutomationProperties.Name="Импортировать каталог LLMGateway" />
                <Button Content="Отменить импорт" Command="{Binding CancelCommand}"
                        Style="{DynamicResource CompactButton}" Margin="0,0,0,4"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.Name="Отменить импорт LLMGateway" />
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       AutomationProperties.Name="Состояние импорта LLMGateway" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProvidersAccountsViewModel}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
                <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Theme.Warning}" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <ContentControl Content="{Binding GatewayImport}" />
            </StackPanel>

            <!-- Main Content (Two Columns) -->
            <Grid Grid.Row="1" Margin="0,6,0,6" IsEnabled="{Binding IsGatewayImportIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Providers & Plugins -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Configured Providers -->
                    <Border Grid.Row="0" Style="{DynamicResource PanelBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="+ Новый" Command="{Binding NewProviderCommand}" Style="{DynamicResource CompactButton}" />
                                    <TextBlock Text="Провайдеры" Style="{DynamicResource SectionHeaderText}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                     IsEnabled="{Binding CanSelectProvider}" Background="Transparent" BorderThickness="0" Margin="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding BaseUrl}" Style="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border Style="{DynamicResource BadgeBorder}" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding BackendDisplay}" Style="{DynamicResource BadgeText}" />
                                                    </Border>
                                                    <TextBlock Text="Ссылка на секрет сохранена" FontSize="10" Foreground="{DynamicResource Theme.Text.Secondary}"
                                                               Visibility="{Binding HasSecretRef, Converter={StaticResource BooleanToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Active Plugins -->
                    <Border Grid.Row="1" Style="{DynamicResource PanelBorder}" Margin="0,8,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                                <TextBlock Text="Плагины OpenCode" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="6,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Provider Form & Models -->
                <Border Grid.Column="1" Style="{DynamicResource PanelBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,8">
                            <TextBlock Text="Профиль LLMGateway загружается из каталога нативных клиентов. Аккаунты доступны ниже; модели и маршруты — в соответствующем разделе."
                                       TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,0,0,8"
                                       Visibility="{Binding IsNativeGatewayProvider, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Text="{Binding SelectedProvider.Limitations}" TextWrapping="Wrap" Style="{DynamicResource WarningText}" Margin="0,0,0,8"
                                       Visibility="{Binding SelectedProvider.HasLimitations, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}" />
                            <StackPanel IsEnabled="{Binding CanConfigureProvider}"
                                        Visibility="{Binding IsNativeGatewayProvider, Converter={StaticResource InverseBooleanToVisibility}}">
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="Конфигурация провайдера" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                            <!-- ID & Display Name -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="ID провайдера:" Style="{DynamicResource StatusLabel}" />
                                    <TextBox Text="{Binding EditingProviderId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsProviderIdReadOnly}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Отображаемое имя:" Style="{DynamicResource StatusLabel}" />
                                    <TextBox Text="{Binding EditingDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Base URL & Validation -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Базовый URL (OpenAI-совместимый):" Style="{DynamicResource StatusLabel}" />
                                <TextBox Text="{Binding EditingBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding UrlValidationStatus}" FontSize="11" Margin="2,2,0,0" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Text.Secondary}" />
                            </StackPanel>

                            <!-- API Key Input -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="API-ключ (сохраняется в хранилище секретов приложения):" Style="{DynamicResource StatusLabel}" />
                                <views:ProviderApiKeyBox AutomationProperties.Name="API-ключ провайдера" />
                                <TextBlock Text="Открытый ключ никогда не сохраняется в базе данных или логах. Используются ссылки на секреты." Style="{DynamicResource SecondaryText}" FontSize="10" Margin="2,1,0,0" />
                            </StackPanel>

                            <!-- Stored Secret Reference & Enabled -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                <CheckBox Content="Включён" IsChecked="{Binding EditingIsEnabled}" VerticalAlignment="Center" />
                                <TextBlock Text="Состояние секрета:" Style="{DynamicResource StatusLabel}" Margin="16,0,4,0" />
                                <TextBlock Text="{Binding ApiKeySecretStateText}" Style="{DynamicResource StatusValue}" />
                            </StackPanel>

                            <Expander Header="HTTP-заголовки" Margin="0,0,0,8" Foreground="{DynamicResource Theme.Text.Primary}">
                                <StackPanel>
                                    <TextBlock Text="Сохранённые секреты не отображаются. Пустое поле сохраняет прежнее значение; для удаления удалите строку."
                                               TextWrapping="Wrap" Style="{DynamicResource SecondaryText}" Margin="0,4" />
                                    <ItemsControl ItemsSource="{Binding EditingHeaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Удалить"
                                                                Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{DynamicResource CompactButton}" />
                                                        <CheckBox DockPanel.Dock="Right" Content="Секрет" IsChecked="{Binding IsSecret}" Margin="8,0" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Имя HTTP-заголовка" />
                                                    </DockPanel>
                                                    <views:ProviderHeaderValueBox Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding ValueWatermark}" Style="{DynamicResource SecondaryText}" FontSize="10" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Добавить заголовок" Command="{Binding AddHeaderCommand}"
                                            Style="{DynamicResource CompactButton}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>

                            <!-- Action Buttons -->
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="Проверить подключение" Command="{Binding TestConnectionCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                                <Button Content="Обновить модели" Command="{Binding RefreshModelsCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                                <Button Content="Предпросмотр diff конфигурации" Command="{Binding PreviewConfigCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                                <Button Content="Сохранить провайдера" Command="{Binding ConfirmAndSaveCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" FontWeight="SemiBold" />
                                <Button Content="Удалить" Command="{Binding DeleteProviderCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                                <Button Content="Экспорт диагностики" Command="{Binding ExportDiagnosticsCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                            </WrapPanel>

                            <!-- Connection Test Feedback -->
                            <Border Style="{DynamicResource TimelineCard}" Margin="0,0,0,8">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Диагностический статус подключения:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ConnectionTestMessage, TargetNullValue='Ещё не проверялось'}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            </StackPanel>
                            <Expander Header="Аккаунты: создание, импорт и лимиты" Margin="0,4,0,8"
                                      IsExpanded="{Binding IsNativeGatewayProvider, Mode=OneWay}"
                                      Foreground="{DynamicResource Theme.Text.Primary}"
                                      AutomationProperties.Name="Управление аккаунтами">
                                <ContentControl Content="{Binding AccountManagement}" />
                            </Expander>

                            <!-- Discovered Models -->
                            <TextBlock Text="Модели и возможности" Style="{DynamicResource SectionHeaderText}" Margin="0,4,0,2" />
                            <ItemsControl ItemsSource="{Binding DiscoveredModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="4,3">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CapabilitiesSummary}" FontSize="10" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom Row: Approval Rules (ТЗ §6.7) -->
            <Border Grid.Row="2" Style="{DynamicResource PanelBorder}" Margin="0,4,0,0">
                <DockPanel Margin="8,4">
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Удалить правило" Command="{Binding RemoveApprovalRuleCommand}" Style="{DynamicResource CompactButton}" />
                            <TextBlock Text="Операционные правила подтверждения (ТЗ §6.7)" Style="{DynamicResource SectionHeaderText}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,2">
                        <TextBlock Text="Проект:" Style="{DynamicResource StatusLabel}" />
                        <ComboBox ItemsSource="{Binding RuleProjects}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  SelectedValue="{Binding NewRuleProjectId, Mode=TwoWay}" Width="160" Margin="0,0,8,6"
                                  AutomationProperties.Name="Проект для правила подтверждения" />
                        <TextBlock Text="Операция:" Style="{DynamicResource StatusLabel}" />
                        <TextBox Text="{Binding NewRuleOperation, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" />
                        <TextBlock Text="Область путей:" Style="{DynamicResource StatusLabel}" />
                        <TextBox Text="{Binding NewRulePathScope, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,0" />
                        <Button Content="+ Добавить правило" Command="{Binding AddApprovalRuleCommand}" Style="{DynamicResource CompactButton}" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding ApprovalRules}" SelectedItem="{Binding SelectedApprovalRule}"
                             MaxHeight="100" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Border Style="{DynamicResource BadgeBorder}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Kind}" Style="{DynamicResource BadgeText}" />
                                    </Border>
                                    <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ScopeSummary}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Modal Diff Preview Dialog Overlay -->
            <Grid Grid.RowSpan="3" Background="#80000000"
                  views:ModalFocus.CloseCommand="{Binding PreviewDialog.CancelCommand}"
                  Visibility="{Binding PreviewDialog.IsVisible, Converter={StaticResource BooleanToVisibility}}">
                <Border Style="{DynamicResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="620" Height="420" Padding="14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Предпросмотр конфигурации и diff OpenCode" Style="{DynamicResource ScreenHeaderText}" />
                                <TextBlock Text="Секреты скрыты. Подтверждение сохраняет профиль в этом приложении. Конфигурация внешнего сервера OpenCode не изменяется."
                                           Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Подтвердить и сохранить" Command="{Binding PreviewDialog.ConfirmCommand}" Style="{DynamicResource CompactButton}" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <Button Content="Отмена" Command="{Binding PreviewDialog.CancelCommand}" Style="{DynamicResource CompactButton}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource Theme.Surface.Alt}">
                            <TextBox Text="{Binding PreviewDialog.DiffText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" Padding="6" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AccountManagementViewModel}">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Новая запись хранит настройки аккаунта. Вход выполняется в нативном клиенте; импорт не подтверждает авторизацию или аккаунт, ответивший на запрос."
                       Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Theme.Warning}" TextWrapping="Wrap" Margin="0,6" />
            <StackPanel IsEnabled="{Binding CanRead}">
                <TextBlock Text="Профиль аккаунта:" Style="{DynamicResource StatusLabel}" />
                <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding Profile}"
                          AutomationProperties.Name="Профиль аккаунта" />
                <WrapPanel Margin="0,6">
                    <Button Content="Обновить аккаунты" Command="{Binding RefreshCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                    <Button Content="Новая запись" Command="{Binding NewCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                    <Button Content="Обнаружить контексты" Command="{Binding DiscoverCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,4" />
                </WrapPanel>
                <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Display"
                         MaxHeight="140" AutomationProperties.Name="Сохранённые аккаунты" />
                <TextBlock Text="{Binding SelectedAccount.Details}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4">
                    <TextBlock Text="{Binding SelectedAccount.SessionBindings}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                               AutomationProperties.Name="Локальные привязки сессий аккаунта" />
                </ScrollViewer>
                <Button Content="Обновить привязку аккаунта" Command="{Binding RefreshAdaptationCommand}" HorizontalAlignment="Left" Style="{DynamicResource CompactButton}" Margin="0,4"
                        Visibility="{Binding ShowAdaptationConfiguration, Converter={StaticResource BooleanToVisibility}}" />
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="Имя аккаунта:" Style="{DynamicResource StatusLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Имя аккаунта" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Приоритет (≥ 0):" Style="{DynamicResource StatusLabel}" />
                            <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Приоритет аккаунта" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Лимит выполнений (≥ 1):" Style="{DynamicResource StatusLabel}" />
                            <TextBox Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Лимит выполнений аккаунта" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Резерв (0–1, пусто = нет):" Style="{DynamicResource StatusLabel}" />
                            <TextBox Text="{Binding Reserve, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Резерв аккаунта" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Аккаунт включён" IsChecked="{Binding Enabled}" />
                    <Button Content="Сохранить настройки аккаунта" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Style="{DynamicResource CompactButton}" Margin="0,6" />
                    <StackPanel Visibility="{Binding ShowAdaptationConfiguration, Converter={StaticResource BooleanToVisibility}}" Margin="0,4,0,8">
                        <TextBlock Text="Привязка для адаптации через OpenCode" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding AdaptationStatus}" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4" />
                        <StackPanel IsEnabled="{Binding CanChangeAdaptationConfiguration}">
                            <TextBlock Text="Новый API-ключ этого аккаунта (сохранённое значение не показывается):" Style="{DynamicResource StatusLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <views:AccountApiKeyBox />
                            <WrapPanel Margin="0,4">
                                <Button Content="Сохранить ключ аккаунта" Command="{Binding SaveAccountKeyCommand}" Style="{DynamicResource CompactButton}" Margin="0,0,6,0" />
                                <Button Content="Очистить введённый ключ" Command="{Binding ClearAccountKeyCommand}" Style="{DynamicResource CompactButton}" />
                            </WrapPanel>
                            <TextBlock Text="Native provider ID из модели (например, openai или openrouter):" Style="{DynamicResource StatusLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding NativeProviderId, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="Native-провайдер аккаунта" />
                            <Button Content="Привязать native-провайдера" Command="{Binding BindNativeProviderCommand}" HorizontalAlignment="Left" Style="{DynamicResource CompactButton}" Margin="0,4" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Контекст для импорта:" Style="{DynamicResource StatusLabel}" />
                    <ComboBox ItemsSource="{Binding ImportCandidates}" SelectedItem="{Binding SelectedImport}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Нативный контекст для импорта" />
                    <Button Content="Импортировать выбранный контекст" Command="{Binding ImportCommand}" HorizontalAlignment="Left" Style="{DynamicResource CompactButton}" Margin="0,6" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:QuotasViewModel}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with summary badges -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" VerticalAlignment="Center" />
                    <Border Style="{DynamicResource BadgeBorder}">
                        <TextBlock Text="{Binding TotalBucketsDisplay}" Style="{DynamicResource BadgeText}" />
                    </Border>
                    <Border Style="{DynamicResource BadgeBorder}">
                        <TextBlock Text="{Binding FreshBucketsDisplay}" Style="{DynamicResource BadgeText}" />
                    </Border>
                    <Border Style="{DynamicResource BadgeBorder}">
                        <TextBlock Text="{Binding DegradedBucketsDisplay}" Style="{DynamicResource BadgeText}" />
                    </Border>
                    <Border Style="{DynamicResource BadgeBorder}">
                        <TextBlock Text="{Binding TrustedNumericBucketsDisplay}" Style="{DynamicResource BadgeText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Toolbar: refresh + routing simulation controls -->
            <WrapPanel Grid.Row="1" Margin="0,6,0,6">
                <Button Content="Обновить всё" Command="{Binding RefreshAllCommand}" Style="{DynamicResource CompactButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Политика:" Style="{DynamicResource StatusLabel}" Margin="10,0,4,0" />
                <ComboBox ItemsSource="{Binding AvailablePolicies}" SelectedItem="{Binding SelectedPolicy}" MinWidth="120" VerticalAlignment="Center" />
                <TextBlock Text="Провайдер:" Style="{DynamicResource StatusLabel}" Margin="10,0,4,0" />
                <TextBox Text="{Binding SimulationProviderProfileId, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalAlignment="Center" />
                <TextBlock Text="Модель:" Style="{DynamicResource StatusLabel}" Margin="8,0,4,0" />
                <TextBox Text="{Binding SimulationModelId, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalAlignment="Center" />
                <TextBlock Text="Закреплённый аккаунт:" Style="{DynamicResource StatusLabel}" Margin="8,0,4,0" />
                <TextBox Text="{Binding PinnedAccountId, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalAlignment="Center" />
                <CheckBox Content="Учитывать оценочные/локальные" IsChecked="{Binding OptInEstimatedQuota}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Content="Симулировать маршрутизацию" Command="{Binding SimulateRoutingCommand}" Style="{DynamicResource CompactButton}" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource WarningText}" Margin="10,0,0,0" />
            </WrapPanel>

            <!-- Main content: quota buckets + routing dashboard -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="360" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                            <TextBlock Text="Корзины квот (все аккаунты и семейства моделей)" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <Grid>
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       Style="{DynamicResource EmptyStateText}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasBuckets, Converter={StaticResource InverseBooleanToVisibility}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="6"
                                          Visibility="{Binding HasBuckets, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Buckets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource TimelineCard}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Обновить"
                                                            Command="{Binding DataContext.RefreshAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource CompactButton}"
                                                            VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding AccountName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AccountId}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ProviderProfileName}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding BucketDisplayName}" Style="{DynamicResource StatusValue}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                            <Border Style="{DynamicResource QuotaProvenanceBadge}" Margin="10,0,4,0">
                                                                <TextBlock Text="{Binding ProvenanceBadgeText}" Style="{DynamicResource QuotaProvenanceBadgeText}" />
                                                            </Border>
                                                            <Border Style="{DynamicResource QuotaFreshnessBadge}">
                                                                <TextBlock Text="{Binding FreshnessBadgeText}" Style="{DynamicResource QuotaFreshnessBadgeText}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,4,0,0">
                                                            <TextBlock Text="Остаток:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding RemainingDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="Использовано:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding UsedDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="Лимит:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding TotalLimitDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding Units}" Style="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <TextBlock Text="Окно:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding LimitWindowDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="Достоверность:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding ConfidenceDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="Сброс:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding ResetTimeDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="Обновлено:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding LastUpdatedDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="След. обновление:" Style="{DynamicResource StatusLabel}" />
                                                            <TextBlock Text="{Binding NextRefreshDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding ScoreEligibilityDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding ErrorDisplay}"
                                                                   Style="{DynamicResource WarningText}"
                                                                   FontSize="10"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource PanelBorder}" Margin="8,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                            <TextBlock Text="Панель и объяснение маршрутизации" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Результат:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding RoutingOutcomeDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                    <TextBlock Text="Политика:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding RoutingPolicyDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,10,0" />
                                    <TextBlock Text="Источник:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding PolicySourceDisplay}" Style="{DynamicResource StatusValue}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock Text="Выбранный аккаунт:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding SelectedAccountDisplay}" Style="{DynamicResource StatusValue}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock Text="ID снимка квот:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding ActiveQuotaSnapshotIdDisplay}" Style="{DynamicResource StatusValue}" />
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RoutingScoreSummary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock Text="Разрешение равенства:" Style="{DynamicResource StatusLabel}" />
                                    <TextBlock Text="{Binding TieBreakDisplay}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                                </WrapPanel>
                                <TextBlock Text="{Binding RoutingExplanation}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ReplacementSessionNotice}"
                                           Style="{DynamicResource WarningText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding RequiresReplacementSession, Converter={StaticResource BooleanToVisibility}}" />

                                <TextBlock Text="Оценки кандидатов" Style="{DynamicResource SectionHeaderText}" />
                                <ItemsControl ItemsSource="{Binding CandidateScores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource TimelineCard}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource Theme.Selection.Background}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding SelectionBadgeText}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding AccountName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AccountId}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TotalScoreDisplay}" Style="{DynamicResource StatusValue}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ComponentBreakdownDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding QuotaSnapshotDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Нет оценённых кандидатов."
                                           Style="{DynamicResource SecondaryText}"
                                           FontSize="11"
                                           Visibility="{Binding HasCandidateScores, Converter={StaticResource InverseBooleanToVisibility}}" />

                                <TextBlock Text="Отклонённые кандидаты" Style="{DynamicResource SectionHeaderText}" />
                                <ItemsControl ItemsSource="{Binding RejectedCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource TimelineCard}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource Theme.Warning.Surface}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Error}" />
                                                        </Border>
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding AccountId}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Нет отклонённых кандидатов."
                                           Style="{DynamicResource SecondaryText}"
                                           FontSize="11"
                                           Visibility="{Binding HasRejectedCandidates, Converter={StaticResource InverseBooleanToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding PolicyNote}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,0" />
        </Grid>
    </DataTemplate>

    <!-- One session affected by an unhealthy route. The required action is stated, never implied. -->
    <DataTemplate DataType="{x:Type vm:ImpactedSessionViewModel}">
        <StackPanel Margin="0,3,0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding SessionIdDisplay}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding StateDisplay}" FontSize="11" Margin="0,0,10,0" />
                <TextBlock Text="проект:" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ProjectIdDisplay}" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="нативный:" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding NativeSessionIdDisplay}" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="роль:" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RoleDisplay}" FontSize="11" Margin="4,0,0,0" />
            </StackPanel>

            <!-- A stopped turn is a warning: the user must confirm a replacement session. -->
            <TextBlock Text="{Binding ImpactDisplay}"
                       Style="{DynamicResource WarningText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="{Binding RequiresReplacementSession, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ImpactDisplay}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="{Binding RequiresReplacementSession, Converter={StaticResource InverseBooleanToVisibility}}" />

            <TextBlock Text="{Binding ExplanationDisplay}"
                       Style="{DynamicResource SecondaryText}"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- One audited health transition. Forced and verified recoveries are labelled differently. -->
    <DataTemplate DataType="{x:Type vm:HealthAuditEntryViewModel}">
        <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="0" Text="{Binding OccurredAtDisplay}" FontSize="11" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="1" Text="{Binding PreviousStateDisplay}" FontSize="11" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="2" Text="{Binding NewStateDisplay}" FontSize="11" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="3" Text="{Binding RecoveryKindDisplay}" FontSize="11" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Grid.Column="4" Text="{Binding ReasonDisplay}" FontSize="11" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <!-- One observed health scope. Routing exclusion and forced state are stated, never implied. -->
    <DataTemplate DataType="{x:Type vm:HealthScopeViewModel}">
        <StackPanel Margin="0,3,0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ScopeTypeDisplay}" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ScopeIdDisplay}" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding StateDisplay}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RoutingDisplay}" FontSize="11" Margin="0,0,10,0" />
                <TextBlock Text="сбоев:" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding FailureCountDisplay}" FontSize="11" Margin="4,0,10,0" />
                <TextBlock Text="класс:" Style="{DynamicResource SecondaryText}" FontSize="11" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ErrorClassDisplay}" FontSize="11" Margin="4,0,0,0" />
            </StackPanel>

            <!-- A forced route must never look like a recovered one. -->
            <TextBlock Text="{Binding ForcedWarning}"
                       Style="{DynamicResource WarningText}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsForcedWithoutVerification, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Text="{Binding ProbeWarning}"
                       Style="{DynamicResource WarningText}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Visibility="{Binding RequiresProbe, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HealthCenterViewModel}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
            <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{DynamicResource SecondaryText}" Margin="0,0,0,8" />
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Здоровье:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding HealthIndicator}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ScopeNote}" Style="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>

            <!-- Degraded state: the health service is not wired into this window. -->
            <TextBlock Grid.Row="3"
                       Text="{Binding UnavailableNotice}"
                       Style="{DynamicResource WarningText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding IsHealthCenterAvailable, Converter={StaticResource InverseBooleanToVisibility}}" />

            <!-- Recovery controls: a probe result is recorded, never assumed. A connection probe confirms
                 the endpoint only; a verified recovery needs the pinned model probe, and neither is
                 replaced by a "Probe passed" button. -->
            <StackPanel Grid.Row="4"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsHealthCenterAvailable, Converter={StaticResource BooleanToVisibility}}">
                <WrapPanel>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <Button Content="Проверить соединение" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0" />
                    <Button Content="Проверить модель" Command="{Binding ProbeModelCommand}" Margin="0,0,10,0" />
                    <Button Content="Проверить кулдаун" Command="{Binding CheckCooldownCommand}" Margin="0,0,10,0" />
                    <Button Content="Отключить" Command="{Binding DisableCommand}" Margin="0,0,4,0" />
                    <Button Content="Включить" Command="{Binding EnableCommand}" Margin="0,0,4,0" />
                    <Button Content="Принудительно включить" Command="{Binding ForceEnableCommand}" />
                </WrapPanel>

                <!-- The pinned model probe may spend quota, so the model and a cost preview are required
                     before it can be run. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Модель:" Style="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding ModelIdToProbe, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                    <CheckBox Content="Оценка стоимости подтверждена"
                              IsChecked="{Binding CostPreviewAcknowledged}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ModelProbePreview}"
                           Style="{DynamicResource SecondaryText}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="5" Style="{DynamicResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <TextBlock Text="Отслеживаемые области" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                    </Border>
                    <StackPanel Margin="8,6,8,6">
                        <ListBox ItemsSource="{Binding Scopes}"
                                 SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                                 MaxHeight="150"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Visibility="{Binding HasScopes, Converter={StaticResource BooleanToVisibility}}" />

                        <!-- Empty state is driven by observed data, not by an invented placeholder row. -->
                        <TextBlock Text="{Binding EmptyStateMessage}"
                                   Style="{DynamicResource SecondaryText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasScopes, Converter={StaticResource InverseBooleanToVisibility}}" />

                        <!-- Impacted sessions: what this unhealthy route is doing to real work. -->
                        <TextBlock Text="Затронутые сессии" Style="{DynamicResource SectionHeaderText}" Margin="0,8,0,2"
                                   Visibility="{Binding IsImpactedSessionViewAvailable, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ImpactedSessions}" />
                        <TextBlock Text="{Binding ImpactedSessionSummary}"
                                   Style="{DynamicResource SecondaryText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsImpactedSessionViewAvailable, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Text="Аудит восстановления" Style="{DynamicResource SectionHeaderText}" Margin="0,8,0,2"
                                   Visibility="{Binding HasAudit, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Audit}" />

                        <!-- Result of the last executed probe, kept distinct from an operator judgement. -->
                        <TextBlock Text="{Binding ProbeResultSummary}"
                                   Style="{DynamicResource SecondaryText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasProbeResult, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Text="{Binding ProbeExecutionNote}"
                                   Style="{DynamicResource SecondaryText}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="6"
                       Text="{Binding Blocker}"
                       Style="{DynamicResource WarningText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock Grid.Row="7" Text="{Binding CliStatus.Headline}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,0" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsDiagnosticsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
                <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}" Margin="0,0,0,4" />

                <TextBlock Text="Внешний вид" Style="{DynamicResource SectionHeaderText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ThemeSelector.SetDarkCommand}" Style="{DynamicResource DarkThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="✓" Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsDarkSelected, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="Тёмная" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ThemeSelector.SetLightCommand}" Style="{DynamicResource LightThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="✓" Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsLightSelected, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="Светлая" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ThemeSelector.SetSystemCommand}" Style="{DynamicResource SystemThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="✓" Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsSystemSelected, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="Системная" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding ThemeSelector.EffectiveThemeDisplay}"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ThemeSelector.PersistenceWarning}"
                           Style="{DynamicResource WarningText}"
                           Margin="0,4,0,0" />

                <TextBlock Text="Бэкенд CLI" Style="{DynamicResource SectionHeaderText}" />
                <ItemsControl ItemsSource="{Binding CliStatus.Tools}" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Повторить проверку"
                            Command="{Binding CliStatus.RefreshCommand}"
                            Style="{DynamicResource CompactButton}" />
                    <TextBlock Text="{Binding CliStatus.Headline}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CliStatus.LastCheckedDisplay}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock Text="Пути" Style="{DynamicResource SectionHeaderText}" />
                <WrapPanel Margin="0,2">
                    <TextBlock Text="Данные приложения:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding AppDataDirectory}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" ToolTip="{Binding AppDataDirectory}" />
                </WrapPanel>
                <WrapPanel Margin="0,2">
                    <TextBlock Text="База данных:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding DatabasePath}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" ToolTip="{Binding DatabasePath}" />
                </WrapPanel>
                <WrapPanel Margin="0,2">
                    <TextBlock Text="Журналы:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding LogsDirectory}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" ToolTip="{Binding LogsDirectory}" />
                </WrapPanel>
                <WrapPanel Margin="0,2">
                    <TextBlock Text="Диагностические пакеты:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding DiagnosticBundlesDirectory}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" ToolTip="{Binding DiagnosticBundlesDirectory}" />
                </WrapPanel>

                <TextBlock Text="Среда выполнения" Style="{DynamicResource SectionHeaderText}" />
                <WrapPanel Margin="0,2">
                    <TextBlock Text="Платформа:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding RuntimeDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" />
                </WrapPanel>
                <WrapPanel Margin="0,2">
                    <TextBlock Text="ОС:" Style="{DynamicResource StatusLabel}" />
                    <TextBlock Text="{Binding OperatingSystemDisplay}" Style="{DynamicResource StatusValue}" Margin="0,0,12,0" />
                </WrapPanel>

                <TextBlock Text="{Binding RedactionNote}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,8,0,0" />
                <TextBlock Text="{Binding RedactedExportNote}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,4,0,8" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- One entry of the immutable workflow archive tree. The grouped Path hierarchy is carried by the
         indentation depth, and the item template binds only to its own view model. -->
    <DataTemplate DataType="{x:Type vm:WorkflowTreeNodeViewModel}">
        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
            <TextBlock Text="{Binding KindDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,0,6,0" />
            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Name}" FontSize="11" Margin="0,0,8,0" />
            <TextBlock Text="{Binding SizeDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" />
        </StackPanel>
    </DataTemplate>

    <!-- One immutable workflow package card. It binds only to its own view model, never to the parent
         screen, so the card templates stay isolated. -->
    <DataTemplate DataType="{x:Type vm:WorkflowPackageItemViewModel}">
        <StackPanel Margin="0,3,0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Name}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SourceTypeDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TagsDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" />
            </StackPanel>
            <TextBlock Text="{Binding DescriptionDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OriginalHashDisplay}" Style="{DynamicResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- One immutable workflow version. The active marker reflects the binding of the selected project. -->
    <DataTemplate DataType="{x:Type vm:WorkflowVersionItemViewModel}">
        <StackPanel Margin="0,3,0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding VersionDisplay}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ActiveStateDisplay}" FontSize="10" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CreatedAtDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" />
            </StackPanel>
            <TextBlock Text="{Binding BlobIdDisplay}" Style="{DynamicResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- One project binding row. The binding is the only mutable record; the package and version are not. -->
    <DataTemplate DataType="{x:Type vm:WorkflowBindingViewModel}">
        <StackPanel Margin="0,3,0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding ProjectDisplay}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding RoutePolicyDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" Margin="0,0,8,0" />
                <TextBlock Text="{Binding UpdatedAtDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" />
            </StackPanel>
            <TextBlock Text="{Binding ActiveVersionIdDisplay}" Style="{DynamicResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkflowLibraryViewModel}">
        <Grid Margin="10">
            <!-- The complete page stays reachable when wrapped status text consumes a narrow window. -->
            <ScrollViewer x:Name="LibraryScreenScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{DynamicResource ScreenHeaderText}" />
            <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{DynamicResource SecondaryText}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="2"
                       Text="{Binding LibraryNote}"
                       Style="{DynamicResource SecondaryText}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <!--
                The run strip precedes the controls and describes the same observed run they act on.
                The enclosing page can scroll in a narrow window so neither this complete status text
                nor the library actions below it become unreachable. Nothing here is read from the editor.
            -->
            <Border x:Name="LibraryRunStatusStrip"
                    Grid.Row="3"
                    Style="{DynamicResource PanelHeaderBorder}" Padding="8,4"
                    Margin="0,0,0,6">
                <Grid Margin="6,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Активный запуск" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding RunCommandStateDisplay}"
                                   Style="{DynamicResource StatusValue}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StartAssignedRunUnavailableReason}"
                                   Style="{DynamicResource WarningText}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   AutomationProperties.Name="Почему запуск run недоступен"
                                   Visibility="{Binding HasStartAssignedRunUnavailableReason, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Артефакт текущей стадии" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding StageArtifactRequirementDisplay}"
                                   Style="{DynamicResource StatusValue}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Проверка ревьюеров" Style="{DynamicResource StatusLabel}" />
                        <TextBlock Text="{Binding ReviewGateRequirementDisplay}"
                                   Style="{DynamicResource StatusValue}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReviewGateStateDisplay}"
                                   Style="{DynamicResource SecondaryText}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Degraded state: the immutable workflow services are not wired into this window. -->
            <TextBlock Grid.Row="4"
                       Text="{Binding LibraryUnavailableNotice}"
                       Style="{DynamicResource WarningText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsLibraryAvailable, Converter={StaticResource InverseBooleanToVisibility}}" />

            <!--
                The library and the project binding share one bounded, scrollable region. The run surface
                moved out of the binding column into its own band below, which gave this row the freedom to
                be shorter than its content - so the region scrolls instead of cutting the last row of
                binding actions off, exactly as the band does for the run panels. The floor keeps the
                packages, the versions and the project binding on screen even in the narrow layout with the
                navigation and inspector panes open, where the run band is competing for the same height.
            -->
            <ScrollViewer x:Name="LibraryBrowserScroll"
                          Grid.Row="4"
                          Visibility="{Binding IsLibraryAvailable, Converter={StaticResource BooleanToVisibility}}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MinHeight="150"
                          MaxHeight="150">
                <Grid Visibility="{Binding IsLibraryAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource PanelBorder}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}" Padding="8,4">
                            <TextBlock Text="Пакеты" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <StackPanel Margin="8,6,8,6">
                            <ListBox x:Name="LibraryPackagesPicker"
                                     ItemsSource="{Binding Packages}"
                                     SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                                     IsEnabled="{Binding IsRunSelectionEditable}"
                                     MaxHeight="260"
                                     BorderThickness="0"
                                     Background="Transparent" />
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasPackages, Converter={StaticResource InverseBooleanToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource PanelBorder}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}" Padding="8,4">
                            <TextBlock Text="Версии" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <StackPanel Margin="8,6,8,6">
                            <ListBox x:Name="LibraryVersionsPicker"
                                     ItemsSource="{Binding Versions}"
                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                     IsEnabled="{Binding IsRunSelectionEditable}"
                                     MaxHeight="260"
                                     BorderThickness="0"
                                     Background="Transparent" />
                            <TextBlock Text="Выберите пакет для просмотра его неизменяемых версий."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasVersions, Converter={StaticResource InverseBooleanToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource PanelBorder}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}" Padding="8,4">
                            <TextBlock Text="Предпросмотр" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <StackPanel Margin="8,6,8,6">
                            <TextBlock Text="{Binding PreviewUnavailableNotice}"
                                       Style="{DynamicResource WarningText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsPreviewAvailable, Converter={StaticResource InverseBooleanToVisibility}}" />

                            <TextBlock Text="{Binding DocumentationPathDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />

                            <!-- Markdown is shown as read-only text; no HTML/WebView component is used. -->
                            <TextBox Text="{Binding DocumentationContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="140"
                                     Margin="0,4,0,0" />

                            <TextBlock Text="{Binding DocumentationTruncationNotice}"
                                       Style="{DynamicResource WarningText}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding IsDocumentationTruncated, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Text="Файлы" Style="{DynamicResource SectionHeaderText}" Margin="0,8,0,2" />

                            <ListBox ItemsSource="{Binding TreeNodes}"
                                     SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                     Height="150"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="{Binding SelectedFileNotice}"
                                       Style="{DynamicResource WarningText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasSelectedFileNotice, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBox Text="{Binding SelectedFileContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="120"
                                     Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="3" Style="{DynamicResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}" Padding="8,4">
                            <TextBlock Text="Привязка к проекту" Style="{DynamicResource SectionHeaderText}" Margin="0" />
                        </Border>
                        <StackPanel Margin="8,6,8,6">
                            <TextBlock Text="Проект" Style="{DynamicResource SecondaryText}" FontSize="10" />
                            <!--
                                The project, package and version pickers are frozen while a command is
                                running. The product run path captures these three identities before its
                                first await, so a click must not be able to switch the selection under a
                                command that is already committing its side effect.
                            -->
                            <ComboBox x:Name="LibraryProjectPicker"
                                      ItemsSource="{Binding Projects}"
                                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                      IsEnabled="{Binding IsRunSelectionEditable}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,2,0,6" />

                            <TextBlock Text="Политика маршрутизации (необязательно)" Style="{DynamicResource SecondaryText}" FontSize="10" />
                            <TextBox Text="{Binding RoutePolicyId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />

                            <WrapPanel>
                                <Button x:Name="LibraryBindButton"
                                        Content="Привязать"
                                        Command="{Binding BindToProjectCommand}"
                                        AutomationProperties.Name="Привязать выбранный пакет к проекту"
                                        Margin="0,0,4,4" />
                                <Button x:Name="LibrarySetActiveVersionButton"
                                        Content="Сделать активной"
                                        Command="{Binding SetActiveVersionCommand}"
                                        AutomationProperties.Name="Сделать выбранную версию активной"
                                        Margin="0,0,4,4" />
                                <Button x:Name="LibraryAdaptButton"
                                        Content="Адаптировать"
                                        Command="{Binding AdaptWorkflowCommand}"
                                        AutomationProperties.Name="Адаптировать процесс под проект"
                                        Margin="0,0,4,4" />
                                <Button x:Name="LibraryRollbackButton"
                                        Content="Откатить"
                                        Command="{Binding RollbackCommand}"
                                        AutomationProperties.Name="Откатить версию процесса"
                                        Margin="0,0,4,4" />
                                <Button x:Name="LibraryUnbindButton"
                                        Content="Отвязать"
                                        Command="{Binding UnbindCommand}"
                                        AutomationProperties.Name="Отвязать пакет от проекта"
                                        Margin="0,0,4,4" />
                                <Button x:Name="LibraryRefreshButton"
                                        Content="Обновить"
                                        Command="{Binding RefreshCommand}"
                                        AutomationProperties.Name="Обновить список пакетов и версий"
                                        Margin="0,0,0,4" />
                            </WrapPanel>

                            <TextBlock Text="{Binding SelectedProjectDisplay}" Style="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />

                            <TextBlock Text="Привязки" Style="{DynamicResource SectionHeaderText}" Margin="0,8,0,2" />
                            <ListBox ItemsSource="{Binding Bindings}"
                                     SelectedItem="{Binding SelectedBinding, Mode=TwoWay}"
                                     MaxHeight="160"
                                     BorderThickness="0"
                                     Background="Transparent" />
                            <TextBlock Text="Нет привязок для этого проекта."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasBindings, Converter={StaticResource InverseBooleanToVisibility}}" />
                         </StackPanel>
                    </DockPanel>
                </Border>
                </Grid>
            </ScrollViewer>


            <!--
                The product run actions sit in their own full-width band under the library, laid out in
                three columns instead of one tall 250px column. Every control below is the very same
                bound control the single column shipped - the same view model commands, the same
                enablement, the same named refusals - and nothing is collapsed or hidden: the band only
                scrolls when the window is too short for it, so an unoffered action and the reason next
                to it are always on screen together. The band is deliberately not tied to
                IsLibraryAvailable either, so a window composed without the immutable workflow services
                still ships these actions disabled and saying why, exactly as it always did.
            -->
            <ScrollViewer x:Name="LibraryRunActionsScroll"
                          Grid.Row="5"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,6,0,0"
                          MaxHeight="360">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <!--
                        Product run path (ROADMAP 10G). These buttons start and advance a real
                        persisted run of the project's active binding through the composed run
                        service. They are offered only when the selection and the observed run
                        actually allow it, and every refusal is named below - the Studio's
                        coder-gate demonstration stays a separate document check and never
                        reaches this path.
                    -->
                        <Border Style="{DynamicResource PanelHeaderBorder}" Padding="8,4" Margin="0,8,0,2">
                            <StackPanel Margin="6,4,6,4">
                                <TextBlock Text="Запуск" Style="{DynamicResource SectionHeaderText}" />
                                <WrapPanel>
                                    <Button x:Name="LibraryStartRunButton"
                                            Content="Запустить запуск"
                                            Style="{DynamicResource DenseButton}"
                                            Command="{Binding StartAssignedRunCommand}"
                                            AutomationProperties.Name="Запустить запуск активной версии процесса"
                                            ToolTip="{Binding StartAssignedRunUnavailableReason}"
                                            Margin="0,0,4,0" />
                                    <Button x:Name="LibraryAdvanceRunButton"
                                            Content="Переход по схеме"
                                            Style="{DynamicResource DenseButton}"
                                            Command="{Binding AdvanceObservedRunCommand}"
                                            AutomationProperties.Name="Перевести наблюдаемый запуск на следующую стадию" />
                                </WrapPanel>
                                <!--
                                    The run, its stage, its state and its pinned template are stated by the run
                                    strip above, which never scrolls away, so this panel says only what the
                                    two actions themselves have to say.
                                -->
                                <TextBlock x:Name="LibraryStartRunReasonText"
                                           Text="{Binding StartAssignedRunUnavailableReason}"
                                           Style="{DynamicResource WarningText}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Почему запуск недоступен"
                                           Visibility="{Binding HasStartAssignedRunUnavailableReason, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock Text="{Binding RunCommandNotice}"
                                           Style="{DynamicResource SecondaryText}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--
                        Product stage artifact (ROADMAP 10A/10E). The required kind is read from the
                        observed run's own pinned scheme snapshot, so the only operator input here is
                        a local path plus a classification: no hash is typed, no blob store is
                        written and no kind is chosen. The path and the classification are frozen
                        for the whole busy window because the command captures both before its
                        first await.
                    -->
                    <Border Style="{DynamicResource PanelHeaderBorder}" Padding="8,4" Margin="0,6,0,2">
                        <StackPanel Margin="6,4,6,4">
                            <TextBlock Text="Артефакт стадии" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="{Binding StageArtifactRequirementDisplay}"
                                       Style="{DynamicResource StatusValue}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBox x:Name="LibraryStageArtifactPathBox"
                                     Text="{Binding StageArtifactPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsStageArtifactInputEditable}"
                                     AutomationProperties.Name="Локальный путь к файлу артефакта текущей стадии"
                                     ToolTip="Локальный путь к файлу, байты которого станут артефактом"
                                     Margin="0,3,0,0" />
                            <StackPanel Visibility="{Binding StageArtifactRequiresExecution, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="ID успешного выполнения этого запуска" TextWrapping="Wrap" Style="{DynamicResource StatusValue}" Margin="0,3,0,0" />
                                <TextBox x:Name="LibraryStageArtifactExecutionBox" Text="{Binding StageArtifactExecutionId, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsStageArtifactInputEditable}"
                                         AutomationProperties.Name="Выполнение для собранного артефакта"
                                         ToolTip="Ссылка проверяется по базе. Сам файл не подтверждает авторство модели." />
                            </StackPanel>
                            <ComboBox x:Name="LibraryStageArtifactClassificationPicker"
                                      ItemsSource="{Binding StageArtifactClassifications}"
                                      SelectedItem="{Binding StageArtifactClassification, Mode=TwoWay}"
                                      IsEnabled="{Binding IsStageArtifactInputEditable}"
                                      AutomationProperties.Name="Классификация прикрепляемого артефакта"
                                      Margin="0,2,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Converter={StaticResource DataClassificationDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="LibraryAttachStageArtifactButton"
                                        Content="Прикрепить артефакт"
                                        Style="{DynamicResource DenseButton}"
                                        Command="{Binding AttachStageArtifactCommand}"
                                        AutomationProperties.Name="Прикрепить локальный файл как артефакт текущей стадии наблюдаемого запуска" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StageArtifactNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <!--
                        Product user approval (ROADMAP 10J). Two deliberate actions and one
                        comment, and no hash input at all: the run, its stage, the required kind
                        and the stored hash are read from the run's own pinned scheme and its
                        stored artifacts, and the committed bytes are re-hashed before either
                        button is offered. Approve and Reject are unoffered while the comment is
                        empty, so there is no default decision, and the panel states plainly that
                        the recorded approver is the unsigned local Windows logon and that a
                        rejection ends the run.
                    -->
                    <Border Style="{DynamicResource PanelHeaderBorder}" Padding="8,4" Margin="0,6,0,2">
                        <StackPanel Margin="6,4,6,4">
                            <TextBlock Text="Решение пользователя" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="{Binding UserApprovalRequirementDisplay}"
                                       Style="{DynamicResource StatusValue}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding UserApprovalApproverDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBox x:Name="LibraryUserApprovalCommentBox"
                                     Text="{Binding UserApprovalComment, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsUserApprovalInputEditable}"
                                     AutomationProperties.Name="Комментарий к решению пользователя по артефакту текущей стадии"
                                     ToolTip="Комментарий обязателен и для одобрения, и для отклонения"
                                     Margin="0,3,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="LibraryApproveObservedArtifactButton"
                                        Content="Одобрить артефакт"
                                        Style="{DynamicResource DenseButton}"
                                        Command="{Binding ApproveObservedArtifactCommand}"
                                        AutomationProperties.Name="Одобрить сохранённый артефакт текущей стадии наблюдаемого запуска"
                                        Margin="0,0,4,0" />
                                <Button x:Name="LibraryRejectObservedArtifactButton"
                                        Content="Отклонить артефакт"
                                        Style="{DynamicResource DenseButton}"
                                        Command="{Binding RejectObservedArtifactCommand}"
                                        AutomationProperties.Name="Отклонить сохранённый артефакт текущей стадии наблюдаемого запуска" />
                            </WrapPanel>
                            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding UserApprovalNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" /></ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!--
                        Assigned model review (ROADMAP 10L). One action and no input at all: the run,
                        its stage, the required reviewer roles, the route behind each role, the model
                        and the exact verified artifact bytes are resolved by the review service
                        from the run's own pinned template and its stored artifact. There is no role
                        picker, no route field and no hash box, so a click cannot choose who reviews
                        what, and the action never records a verdict - it only asks, and reports
                        truthfully that a request which reached no dispatch boundary persisted
                        nothing.
                    -->
                    <Border Style="{DynamicResource PanelHeaderBorder}" Padding="8,4" Margin="0,6,0,2">
                        <StackPanel Margin="6,4,6,4">
                            <TextBlock Text="Назначенное ревью модели" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="LibraryRequestAssignedReviewButton"
                                        Content="Запросить назначенное ревью"
                                        Style="{DynamicResource DenseButton}"
                                        Command="{Binding RequestAssignedReviewCommand}"
                                        AutomationProperties.Name="Запросить назначенное модельное ревью артефакта текущей стадии наблюдаемого запуска" />
                            </WrapPanel>
                            <TextBlock x:Name="LibraryAssignedReviewRequirementText"
                                       Text="{Binding AssignedReviewRequirementDisplay}"
                                       Style="{DynamicResource StatusValue}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Что именно будет отправлено на назначенное ревью наблюдаемого запуска" />
                            <TextBlock x:Name="LibraryAssignedReviewStatusText"
                                       Text="{Binding AssignedReviewStatusDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Состояние последнего запроса назначенного ревью" />
                            <!--
                                The action sits above the per-role dump on purpose. The dump is a paragraph
                                per required role and is the longest text on this screen, so an action placed
                                after it would be below the fold of the run band on an ordinary window; the
                                operator would have to scroll to find out whether asking is even possible.
                            -->

                            <TextBlock x:Name="LibraryAssignedReviewDetailText"
                                       Text="{Binding AssignedReviewDetailDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Дословный отказ или наблюдаемый маршрут по каждой роли ревьюера" />
                            <TextBlock Text="{Binding AssignedReviewNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                    <!--
                        Reviewer gate status (read-only, ROADMAP 10K). It reports which roles the
                        observed run's own pinned scheme requires on its current stage, and what the
                        persisted verdicts say about each of them on the exact hash of the current
                        verified artifact. There is deliberately no control here: no verdict can be
                        written from this screen, no route can be chosen and no hash can be typed,
                        because a human click must never be able to create model-verdict evidence.
                        The route shown inside a verdict is named as a label stored in that row, never
                        as an observed model run.
                    -->
                    <Border Style="{DynamicResource PanelHeaderBorder}" Padding="8,4" Margin="0,6,0,2">
                        <StackPanel Margin="6,4,6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Проверка ревьюеров"
                                           Style="{DynamicResource SectionHeaderText}"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Status.Idle.Background}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReviewGateStatus.IsEveryRequiredRoleApproved}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Done.Background}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewGateStatus.Availability}" Value="{x:Static vm:WorkflowReviewGateAvailability.ArtifactUnverified}">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Hung.Background}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ReviewGateStatus.StateDisplay}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Idle.Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReviewGateStatus.IsEveryRequiredRoleApproved}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Done.Text}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReviewGateStatus.Availability}" Value="{x:Static vm:WorkflowReviewGateAvailability.ArtifactUnverified}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Hung.Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="LibraryReviewGateRequirementText"
                                       Text="{Binding ReviewGateRequirementDisplay}"
                                       Style="{DynamicResource StatusValue}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Текущий статус проверки ревьюеров наблюдаемого запуска" />
                            <TextBlock x:Name="LibraryReviewGateStateText"
                                       Text="{Binding ReviewGateStateDisplay}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Названная причина, по которой проверка ревьюеров не выводится" />
                            <ItemsControl x:Name="LibraryReviewGateRoles"
                                          ItemsSource="{Binding ReviewGateRoles}"
                                          AutomationProperties.Name="Строки ролей ревьюеров текущей стадии"
                                          Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Role}"
                                                           Style="{DynamicResource StatusLabel}"
                                                           FontSize="10"
                                                           Margin="0" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="9"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="Состояние роли ревьюера">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Status.Idle.Background}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.Approved}">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Done.Background}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.Rejected}">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Stopped.Background}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.RequestChanges}">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Stopped.Background}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.ArtifactUnverified}">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Hung.Background}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.EvidenceUnusable}">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Hung.Background}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="9" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Idle.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.Approved}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Done.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.Rejected}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Stopped.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.RequestChanges}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Stopped.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.ArtifactUnverified}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Hung.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WorkflowReviewGateRoleState.EvidenceUnusable}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Hung.Text}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LibraryReviewGateNoticeText"
                                       Text="{Binding ReviewGateNotice}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding Blocker}"
                           Style="{DynamicResource WarningText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasBlocker, Converter={StaticResource BooleanToVisibility}}" />
                <Border Style="{DynamicResource PanelBorder}"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasActivationBlockers, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Margin="8,6,8,6">
                        <TextBlock Text="Активация заблокирована. Отметьте каждую блокировку отдельно, чтобы повторить действие:"
                                   Style="{DynamicResource WarningText}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ActivationBlockers}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsAcknowledged, Mode=TwoWay}" Margin="0,2,0,0">
                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Display}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="560" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Подтвердить и продолжить"
                                    Command="{Binding ConfirmActivationCommand}"
                                    Margin="0,0,4,0" />
                            <Button Content="Отмена"
                                    Command="{Binding DismissActivationBlockersCommand}"
                                    Style="{DynamicResource DenseButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{DynamicResource SecondaryText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
            </Grid>
            </ScrollViewer>
            <!-- Adaptation dialog overlay (ТЗ §6.14): pre-send preview and candidate session. -->
            <Grid Grid.RowSpan="7"
                  Background="#80000000"
                  views:ModalFocus.CloseCommand="{Binding AdaptationDialog.CancelCommand}"
                  Visibility="{Binding AdaptationDialog.IsVisible, Converter={StaticResource BooleanToVisibility}}">
                <Border Style="{DynamicResource PanelBorder}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MaxWidth="1000"
                        MaxHeight="660"
                        Margin="12"
                        Padding="14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Адаптация процесса (ТЗ §6.14)" Style="{DynamicResource ScreenHeaderText}" />
                                <TextBlock Text="Каждый шаг является явной командой; исходный BLOB и активная привязка остаются неизменными до активации. Черновые данные никогда не затрагивают корень проекта."
                                           Style="{DynamicResource SecondaryText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="{Binding AdaptationDialog.ErrorMessage}"
                                       Style="{DynamicResource WarningText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding AdaptationDialog.HasError, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Text="{Binding AdaptationDialog.StatusMessage}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding AdaptationDialog.HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>

                        <!-- State 1: pre-send preview (route, goal, scope, scanned files, quota). -->
                        <Grid DockPanel.Dock="Top" Visibility="{Binding AdaptationDialog.IsSessionActive, Converter={StaticResource InverseBooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Исходная версия" Style="{DynamicResource StatusLabel}" />
                                <TextBlock Text="{Binding AdaptationDialog.SourceVersion.VersionDisplay}" Style="{DynamicResource StatusValue}" />
                                <TextBlock Text="{Binding AdaptationDialog.Package.Name}"
                                           Style="{DynamicResource SecondaryText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8" />

                                <TextBlock Text="Класс исходных материалов" Style="{DynamicResource StatusLabel}" />
                                <ComboBox ItemsSource="{Binding AdaptationDialog.MaterialClassifications}"
                                          SelectedItem="{Binding AdaptationDialog.MaterialClassification, Mode=TwoWay}"
                                          IsEnabled="{Binding AdaptationDialog.CanEditMaterialClassification}"
                                          AutomationProperties.Name="Классификация исходной версии" Margin="0,2,0,4">
                                    <ComboBox.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DataClassificationDisplay}}" />
                                    </DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Сохранить класс материалов" Command="{Binding AdaptationDialog.SaveMaterialClassificationCommand}"
                                        Style="{DynamicResource CompactButton}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AdaptationDialog.MaterialClassificationStatus}"
                                           Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Маршрут адаптера (из каталога)" Style="{DynamicResource StatusLabel}" />
                                <ComboBox ItemsSource="{Binding AdaptationDialog.AvailableRoutes}"
                                          SelectedItem="{Binding AdaptationDialog.SelectedRoute, Mode=TwoWay}"
                                          IsEnabled="{Binding AdaptationDialog.CanEditPreSendInputs}"
                                          DisplayMemberPath="Name"
                                          Margin="0,2,0,8" />

                                <TextBlock Text="Цель адаптации" Style="{DynamicResource StatusLabel}" />
                                <ComboBox ItemsSource="{Binding AdaptationDialog.AvailableGoals}"
                                          SelectedItem="{Binding AdaptationDialog.SelectedGoal, Mode=TwoWay}"
                                          IsEnabled="{Binding AdaptationDialog.CanEditPreSendInputs}"
                                          Margin="0,2,0,8" />

                                <CheckBox Content="Разрешить расширенную семантическую область"
                                          IsChecked="{Binding AdaptationDialog.AllowExpandedSemanticScope}"
                                          IsEnabled="{Binding AdaptationDialog.CanEditPreSendInputs}"
                                          ToolTip="Подсказка для модели: можно предлагать более широкую семантическую область. Это не подтверждение: любое изменение этапов, качественных проверок, эскалации или ролей остаётся блокировкой и требует отдельного подтверждения после просмотра диффа."
                                          Margin="0,0,0,8">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ExpandedScopeCheckBorder" Width="14" Height="14"
                                                        Background="{DynamicResource Theme.Surface.Alt}"
                                                        BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                                        CornerRadius="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Path x:Name="ExpandedScopeCheckMark" Data="M 2 5 L 5 9 L 11 2"
                                                          Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                                </Border>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpandedScopeCheckMark" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="ExpandedScopeCheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ExpandedScopeCheckBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>

                                <TextBlock Text="Оценка квоты" Style="{DynamicResource StatusLabel}" />
                                <TextBlock Text="{Binding AdaptationDialog.CostQuotaEstimateDisplay}" Style="{DynamicResource StatusValue}" Margin="0,2,0,10" />

                                <WrapPanel>
                                    <Button Content="Обновить предпросмотр"
                                            Command="{Binding AdaptationDialog.RefreshPreSendPreviewCommand}"
                                            Style="{DynamicResource DenseButton}"
                                            Margin="0,0,6,4" />
                                    <Button Content="Запустить адаптацию"
                                            Command="{Binding AdaptationDialog.StartAdaptationCommand}"
                                            FontWeight="SemiBold"
                                            Margin="0,0,6,4" />
                                    <Button Content="Отмена"
                                            Command="{Binding AdaptationDialog.CancelCommand}"
                                            Style="{DynamicResource DenseButton}"
                                            Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="150" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Файлы, передаваемые модели-адаптеру (снимите флажок для исключения)"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource SectionHeaderText}"
                                           Margin="0,0,0,2" />

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding AdaptationDialog.PreSendFiles}"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2">
                                                <CheckBox DockPanel.Dock="Left"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanChangeExclusion}"
                                                          ToolTip="{Binding ExclusionNote}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding SecretSummary}"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RelativePath}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBox Grid.Row="2"
                                         Text="{Binding AdaptationDialog.PromptPreview, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="10"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,6,0,0" />
                            </Grid>
                        </Grid>

                        <!-- State 2: candidate unified diff, semantic mappings, blockers and actions. -->
                        <Grid Visibility="{Binding AdaptationDialog.IsSessionActive, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding AdaptationDialog.DiffSummary}"
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{DynamicResource PanelBorder}" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="Изменённые файлы"
                                                   Style="{DynamicResource SectionHeaderText}"
                                                   Margin="6,4" />
                                        <ListBox ItemsSource="{Binding AdaptationDialog.DiffFiles}"
                                                 SelectedItem="{Binding AdaptationDialog.SelectedDiffFile, Mode=TwoWay}"
                                                 BorderThickness="0"
                                                 Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding RelativePath}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                   Style="{DynamicResource SecondaryText}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Background="{DynamicResource Theme.Surface.Alt}"
                                        Margin="0,0,8,0">
                                    <TextBox Text="{Binding AdaptationDialog.SelectedDiffContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="6" />
                                </Border>

                                <Border Grid.Column="2" Style="{DynamicResource PanelBorder}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="Семантические сопоставления ролей"
                                                   Style="{DynamicResource SectionHeaderText}"
                                                   Margin="6,4" />
                                        <ListBox ItemsSource="{Binding AdaptationDialog.RoleMappings}"
                                                 BorderThickness="0"
                                                 Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Role}" FontWeight="SemiBold" FontSize="11" />
                                                        <TextBlock Text="{Binding OriginalRoute}"
                                                                   Style="{DynamicResource SecondaryText}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TargetRoute}"
                                                                   Style="{DynamicResource SecondaryText}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TargetModelId}"
                                                                   Style="{DynamicResource SecondaryText}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Rationale}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="44" />
                                                        <TextBlock Text="{Binding SemanticChangeDisplay}"
                                                                   Style="{DynamicResource WarningText}"
                                                                   FontSize="10"
                                                                   Visibility="{Binding IsSemanticChange, Converter={StaticResource BooleanToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <Border Style="{DynamicResource PanelBorder}"
                                        Padding="8"
                                        Margin="0,0,0,4"
                                        Visibility="{Binding AdaptationDialog.HasBlockers, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Блокировки: активация отклоняется, пока каждая показанная блокировка не подтверждена отдельно."
                                                   Style="{DynamicResource WarningText}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AdaptationDialog.BlockersSummary}"
                                                   Style="{DynamicResource WarningText}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding AdaptationDialog.ActivationBlockers}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAcknowledged, Mode=TwoWay}" Margin="0,2,0,0">
                                                        <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Display}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="880" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ListBox ItemsSource="{Binding AdaptationDialog.Issues}"
                                         MaxHeight="80"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Visibility="{Binding AdaptationDialog.HasIssues, Converter={StaticResource BooleanToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{DynamicResource Theme.Text.Primary}" Text="{Binding Display}" FontSize="10" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox Text="{Binding AdaptationDialog.FollowUpPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Width="520"
                                         VerticalAlignment="Center" />
                                <Button Content="Запросить доработку в той же сессии"
                                        Command="{Binding AdaptationDialog.SubmitFollowUpCommand}"
                                        Style="{DynamicResource DenseButton}"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Принять и активировать"
                                        Command="{Binding AdaptationDialog.AcceptAndActivateCommand}"
                                        FontWeight="SemiBold"
                                        Margin="0,0,8,0" />
                                <Button Content="Сохранить кандидатом"
                                        Command="{Binding AdaptationDialog.SaveCandidateCommand}"
                                        Style="{DynamicResource DenseButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="Отклонить"
                                        Command="{Binding AdaptationDialog.DiscardCommand}"
                                        Style="{DynamicResource DenseButton}" />
                            </WrapPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
