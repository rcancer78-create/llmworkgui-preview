<Window x:Class="LLMWorkGUI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LLMWorkGUI.App.ViewModels"
        xmlns:views="clr-namespace:LLMWorkGUI.App.Views"
        xmlns:help="clr-namespace:LLMWorkGUI.App.Help"
        Title="LLM Work GUI"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource Theme.Background}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LLMWorkGUI.App;component/Themes/Shared.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LLMWorkGUI.App;component/Views/ScreenTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BannerBooleanToVisibility" />

            <Style x:Key="DegradedAwareStatusValue" TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusBar.IsDegraded}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Workspace}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Projects}" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.ProvidersAccounts}" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Models}" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Quotas}" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Sessions}" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Runs}" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.Workflows}" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.HealthCenter}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:ScreenId.SettingsDiagnostics}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCliDetectionCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TopBar" Grid.Row="0" Style="{DynamicResource TopBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Style="{DynamicResource NavigationList}"
                         ItemContainerStyle="{DynamicResource NavigationItem}"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Shortcut}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Theme.Text.Secondary}"
                                           Margin="6,1,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="OpenHelpGuideButton" Command="{x:Static help:HelpCommands.OpenGuide}" Content="Руководство" ToolTip="Руководство пользователя и администратора (F1)" AutomationProperties.Name="Открыть руководство пользователя и администратора" Margin="4,0" />
                    <Button Command="{Binding ThemeSelector.SetDarkCommand}" Style="{DynamicResource DarkThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsDarkSelected, Converter={StaticResource BannerBooleanToVisibility}}" />
                            <TextBlock Text="Тёмная" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ThemeSelector.SetLightCommand}" Style="{DynamicResource LightThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsLightSelected, Converter={StaticResource BannerBooleanToVisibility}}" />
                            <TextBlock Text="Светлая" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ThemeSelector.SetSystemCommand}" Style="{DynamicResource SystemThemeButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       Margin="0,0,4,0"
                                       Visibility="{Binding ThemeSelector.IsSystemSelected, Converter={StaticResource BannerBooleanToVisibility}}" />
                            <TextBlock Text="Системная" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DegradedBanner"
                Grid.Row="1"
                Style="{DynamicResource DegradedBannerBorder}"
                Visibility="{Binding CliStatus.IsDegraded, Converter={StaticResource BannerBooleanToVisibility}}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="ОГРАНИЧЕННЫЙ РЕЖИМ" Style="{DynamicResource WarningText}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CliStatus.Headline}" Style="{DynamicResource WarningText}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding CliStatus.Recommendation}"
                           Style="{DynamicResource SecondaryText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Content="Повторить проверку"
                        Command="{Binding RefreshCliDetectionCommand}"
                        Style="{DynamicResource CompactButton}"
                        VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <Grid x:Name="ShellPanes" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftPanel" Grid.Column="0" Style="{DynamicResource PanelBorder}" Margin="6,6,0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <TextBlock Text="Проекты / Процессы / Сессии" Style="{DynamicResource SectionHeaderText}" Margin="0" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,8">
                        <StackPanel>
                            <TextBlock Text="Проекты" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="Список проектов и добавление папки — на экране «Проекты»."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Закреплённые процессы" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="Сведения о процессах — на экране «Процессы»."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Сессии" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="Список сессий и их состояние — на экране «Сессии»."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="История" Style="{DynamicResource SectionHeaderText}" />
                            <TextBlock Text="История выполнений — на экране «Запуски»."
                                       Style="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{DynamicResource PanelSplitter}" />

            <Border x:Name="CenterPanel" Grid.Column="2" Style="{DynamicResource PanelBorder}" Margin="0,6,0,6">
                <ContentControl Content="{Binding CurrentScreen}" />
            </Border>

            <GridSplitter Grid.Column="3" Style="{DynamicResource PanelSplitter}" />

            <Border x:Name="RightPanel" Grid.Column="4" Style="{DynamicResource PanelBorder}" Margin="0,6,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource PanelHeaderBorder}">
                        <TextBlock Text="Инспектор / контекст" Style="{DynamicResource SectionHeaderText}" Margin="0" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,8">
                        <StackPanel>
                            <TextBlock Text="Активный маршрут" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Провайдер" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Provider}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Аккаунт" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Account}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Модель" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Model}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Рассуждение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Reasoning}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Скорость" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.Speed}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Решение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.RoutingDecisionReason}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>

                            <TextBlock Text="Сессия" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Локальный ID" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.LocalSessionId}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Нативный ID" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.NativeSessionId}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Подтверждение" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.SessionConfirmation}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>

                            <TextBlock Text="Выполнение" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Состояние" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.ExecutionState}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Роль / этап" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.WorkflowRoleStage}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>

                            <TextBlock Text="Квоты" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Сводка" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.QuotaSummary}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Актуальность" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.QuotaFreshness}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>

                            <TextBlock Text="Здоровье" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Индикатор" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.HealthIndicator}" Style="{DynamicResource StatusValue}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Детали" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.HealthDetail}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusBar.HealthScopeNote}" Style="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CliStatus.Tools}" Margin="0,4,0,0" />

                            <TextBlock Text="Проект" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,2">
                                <TextBlock Text="Рабочая область" Style="{DynamicResource StatusLabel}" MinWidth="96" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusBar.ProjectWorkspace}" Style="{DynamicResource StatusValue}" TextWrapping="Wrap" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="GlobalStatusBar" Grid.Row="3" Style="{DynamicResource StatusBarBorder}">
            <WrapPanel>
                <TextBlock Text="Провайдер:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.Provider}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Аккаунт:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.Account}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Модель:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.Model}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Рассуждение:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.Reasoning}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Скорость:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.Speed}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Сессия:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.LocalSessionId}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Нативный:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.NativeSessionId}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Состояние:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.ExecutionState}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Здоровье:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.HealthIndicator}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Рабочая область:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.ProjectWorkspace}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Роль / этап:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.WorkflowRoleStage}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Квоты:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.QuotaSummary}" Style="{DynamicResource StatusValue}" />
                <TextBlock Text=" / " Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.QuotaFreshness}" Style="{DynamicResource StatusValue}" />
                <Border Style="{DynamicResource VerticalDivider}" />

                <TextBlock Text="Бэкенды:" Style="{DynamicResource StatusLabel}" />
                <TextBlock Text="{Binding StatusBar.DegradedIndicatorText}" Style="{DynamicResource DegradedAwareStatusValue}" />
            </WrapPanel>
        </Border>

        <views:UnifiedWorkspaceShellView x:Name="UnifiedWorkspaceShell"
                                         Grid.Row="0"
                                         Grid.RowSpan="4"
                                         Visibility="Collapsed" />
    </Grid>
</Window>
