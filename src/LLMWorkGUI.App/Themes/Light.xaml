<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Palette.Name">Light</sys:String>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Theme.Background" Color="#F3F4F3" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Surface.Alt" Color="#F0F2F1" />
    <SolidColorBrush x:Key="Theme.Surface.Card" Color="#F8F9F8" />
    <SolidColorBrush x:Key="Theme.Border" Color="#CDD3D0" />
    <SolidColorBrush x:Key="Theme.Border.Subtle" Color="#E3E7E4" />

    <SolidColorBrush x:Key="Theme.Text.Primary" Color="#202723" />
    <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#5E6A63" />
    <SolidColorBrush x:Key="Theme.Text.Disabled" Color="#7B867F" />

    <SolidColorBrush x:Key="Theme.Accent" Color="#246B52" />
    <SolidColorBrush x:Key="Theme.Accent.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Selection.Background" Color="#E2EFE7" />

    <SolidColorBrush x:Key="Theme.Warning" Color="#8A4B08" />
    <SolidColorBrush x:Key="Theme.Warning.Surface" Color="#FFF3E0" />
    <SolidColorBrush x:Key="Theme.Success" Color="#116B33" />
    <SolidColorBrush x:Key="Theme.Error" Color="#A02020" />

    <SolidColorBrush x:Key="Theme.Badge.Neutral.Background" Color="#E3E7ED" />
    <SolidColorBrush x:Key="Theme.Badge.Neutral.Text" Color="#39414B" />
    <SolidColorBrush x:Key="Theme.Badge.Synthetic.Background" Color="#EDE4FD" />
    <SolidColorBrush x:Key="Theme.Badge.Synthetic.Text" Color="#5B2FA8" />

    <SolidColorBrush x:Key="Theme.Nav.Background" Color="#F3F4F3" />
    <SolidColorBrush x:Key="Theme.Status.Background" Color="#F3F4F3" />

    <SolidColorBrush x:Key="Theme.Status.Working.Background" Color="#DBEAFE" />
    <SolidColorBrush x:Key="Theme.Status.Working.Border" Color="#93C5FD" />
    <SolidColorBrush x:Key="Theme.Status.Working.Text" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Theme.Status.Hung.Background" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Theme.Status.Hung.Border" Color="#FCD34D" />
    <SolidColorBrush x:Key="Theme.Status.Hung.Text" Color="#B45309" />
    <SolidColorBrush x:Key="Theme.Status.Done.Background" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Theme.Status.Done.Border" Color="#86EFAC" />
    <SolidColorBrush x:Key="Theme.Status.Done.Text" Color="#15803D" />
    <SolidColorBrush x:Key="Theme.Status.Stopped.Background" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Theme.Status.Stopped.Border" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Theme.Status.Stopped.Text" Color="#B91C1C" />
    <SolidColorBrush x:Key="Theme.Status.Idle.Background" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Theme.Status.Idle.Border" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Theme.Status.Idle.Text" Color="#64748B" />

</ResourceDictionary>
